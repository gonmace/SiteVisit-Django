          </label>
          {{ form.email }}
          {% if form.email.errors %}<p class="text-xs text-error mt-1">{{ form.email.errors.0 }}</p>{% endif %}
        </div>

        <!-- RUT -->
        <div class="form-control">
          <label class="label py-1">
            <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">{{ form.rut.label }}</span>
          </label>
          {{ form.rut }}
          {% if form.rut.errors %}<p class="text-xs text-error mt-1">{{ form.rut.errors.0 }}</p>{% endif %}
        </div>

        <!-- Teléfono -->
        <div class="form-control">
          <label class="label py-1">
            <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">{{ form.phone.label }}</span>
          </label>
          {{ form.phone }}
          {% if form.phone.errors %}<p class="text-xs text-error mt-1">{{ form.phone.errors.0 }}</p>{% endif %}
        </div>

        <!-- Cargo -->
        <div class="form-control">
          <label class="label py-1">
            <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">{{ form.cargo.label }}</span>
          </label>
          {{ form.cargo }}
          {% if form.cargo.errors %}<p class="text-xs text-error mt-1">{{ form.cargo.errors.0 }}</p>{% endif %}
        </div>

        <!-- Empresa -->
        {% if locked_company %}
          {{ form.company }}{# hidden input #}
          <div class="form-control">
            <label class="label py-1">
              <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">Empresa</span>
            </label>
            <div class="flex items-center gap-2 h-8">
              <span class="badge badge-outline badge-sm">{{ locked_company|upper }}</span>
              <span class="text-xs text-base-content/40">Asignada a tu empresa</span>
            </div>
          </div>
        {% else %}
          <div class="form-control">
            <label class="label py-1">
              <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">{{ form.company.label }}</span>
            </label>
            {{ form.company }}
            {% if form.company.errors %}<p class="text-xs text-error mt-1">{{ form.company.errors.0 }}</p>{% endif %}
          </div>
        {% endif %}

        <!-- Estado (solo al editar) -->
        {% if form.status %}
        <div class="form-control col-span-2">
          <label class="label py-1">
            <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">{{ form.status.label }}</span>
          </label>
          {{ form.status }}
          {% if form.status.errors %}<p class="text-xs text-error mt-1">{{ form.status.errors.0 }}</p>{% endif %}
          {% if object.status_changed_by %}
          <p class="text-xs text-base-content/40 mt-1.5">
            <i class="fa-solid fa-user-check mr-1"></i>
            Autorizado por <span class="font-medium text-base-content/60">{{ object.status_changed_by.get_full_name|default:object.status_changed_by.email }}</span>
            {% if object.status_changed_at %}· {{ object.status_changed_at|date:"d/m/Y H:i" }}{% endif %}
          </p>
          {% endif %}
        </div>
        {% elif status_locked %}
        <div class="col-span-2 flex items-center gap-2.5 rounded-xl border border-warning/30 bg-warning/8 px-4 py-3">
          <i class="fa-solid fa-lock text-warning text-sm shrink-0"></i>
          <p class="text-xs text-base-content/60">El estado no puede modificarse hasta que el técnico registre su dispositivo.</p>
        </div>
        {% endif %}

      </div>

      <div class="flex justify-end gap-2 mt-6 pt-4 border-t border-base-200">
        <a href="{{ cancel_url }}" class="btn btn-ghost btn-sm h-9 min-h-0 text-xs">Cancelar</a>
        <button type="submit" class="btn btn-primary btn-sm h-9 min-h-0 px-5 text-xs font-semibold">Guardar</button>
      </div>
    </form>
  </div>

  {% if request.user.role == 'super_manager' and object and object.device %}
  <div class="bg-base-100 rounded-2xl border-2 border-error/20 shadow-xs p-5 mt-4">
    <div class="flex items-center justify-between gap-4">
      <div>
        <p class="text-sm font-semibold text-error">Nuevo Dispositivo</p>
        <p class="text-xs text-base-content/40 mt-0.5">Elimina el dispositivo actual. El técnico deberá volver a registrarse desde su nuevo celular.</p>
      </div>
      <form id="form-reset-device" method="post" action="{% url 'manager:technician_reset_device' object.pk %}">
        {% csrf_token %}
        <button type="button"
                id="btn-reset-device"
                class="btn btn-delete btn-sm h-9 min-h-0 px-4 text-xs font-semibold shrink-0">
          Nuevo Dispositivo
        </button>
      </form>
    </div>
  </div>
  {% endif %}

</div>
{% endblock %}

{% block extra_scripts %}
{% if request.user.role == 'super_manager' and object and object.device %}
<script>
  document.getElementById('btn-reset-device').addEventListener('click', function () {
    confirmAction({
      type:        'warning',
      title:       'Eliminar dispositivo',
      message:     'Se eliminará el dispositivo de {{ object.get_full_name|default:object.email|escapejs }}. El técnico deberá volver a registrarse desde su nuevo celular.',
      confirmText: 'Eliminar dispositivo',
      onConfirm:   function () { document.getElementById('form-reset-device').submit(); }
    });
  });
</script>
{% endif %}
{% endblock %}
</file>

<file path="templates/manager/technician_import.html">
{% extends "manager/base.html" %}
{% block title %}Importar Técnicos{% endblock %}

{% block content %}
<div class="max-w-xl mx-auto">

  <!-- Back + title -->
  <div class="flex items-center gap-3 mb-6">
    <a href="{% url 'manager:users_list' %}"
       class="btn btn-ghost btn-sm h-9 min-h-0 border border-base-300 text-base-content/50 text-xs">
      ← Volver
    </a>
    <div>
      <h1 class="text-xl font-bold text-base-content tracking-tight">Importar Técnicos</h1>
      <p class="text-xs text-base-content/40 mt-0.5">Carga masiva desde archivo Excel</p>
    </div>
  </div>

  <!-- Upload card -->
  <div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs overflow-hidden mb-4">

    <form method="post" enctype="multipart/form-data">
      {% csrf_token %}

      <!-- Drop zone -->
      <label for="file-input"
             class="flex flex-col items-center justify-center gap-3 py-12 px-8 cursor-pointer
                    border-b border-base-200 hover:bg-base-50 transition-colors group">
        <div class="w-14 h-14 rounded-2xl bg-primary/8 flex items-center justify-center
                    group-hover:bg-primary/12 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-primary" fill="none"
               viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round"
                  d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <div class="text-center">
          <p class="text-sm font-semibold text-base-content">Seleccionar archivo</p>
          <p class="text-xs text-base-content/40 mt-0.5">.xlsx o .xls</p>
        </div>
        <input id="file-input" type="file" name="file" accept=".xlsx,.xls" class="hidden"
               onchange="document.getElementById('file-name').textContent = this.files[0]?.name || ''">
      </label>

      <!-- File name feedback -->
      <div class="px-6 py-3 min-h-[2.5rem] flex items-center justify-between border-b border-base-200">
        <span id="file-name" class="text-xs text-base-content/50 truncate italic"></span>
        <div class="flex gap-2 shrink-0 ml-4">
          <a href="{% url 'manager:users_list' %}"
             class="btn btn-ghost btn-xs h-7 min-h-0 text-xs text-base-content/40">Cancelar</a>
          <button type="submit"
                  class="btn btn-secondary btn-xs h-7 min-h-0 px-4 text-xs font-semibold">
            Importar
          </button>
        </div>
      </div>
    </form>

    <!-- Column format reference -->
    <div class="px-6 py-5">
      <p class="text-xs font-semibold text-base-content/40 uppercase tracking-wide mb-3">
        Formato de columnas
      </p>
      <div class="flex flex-wrap gap-2">

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">A</span>
          <span class="text-xs font-medium text-base-content">Nombre</span>
          <span class="text-error text-xs leading-none">*</span>
        </div>

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">B</span>
          <span class="text-xs text-base-content/60">Apellido</span>
        </div>

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">C</span>
          <span class="text-xs font-medium text-base-content">Email</span>
          <span class="text-error text-xs leading-none">*</span>
        </div>

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">D</span>
          <span class="text-xs text-base-content/60">RUT</span>
        </div>

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">E</span>
          <span class="text-xs text-base-content/60">Cargo</span>
        </div>

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">F</span>
          <span class="text-xs text-base-content/60">Teléfono</span>
        </div>

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">G</span>
          <span class="text-xs font-medium text-base-content">Empresa</span>
          <span class="text-error text-xs leading-none">*</span>
        </div>

      </div>
      <p class="text-xs text-base-content/30 mt-3">
        <span class="text-error">*</span> Requeridos. Empresa: <code class="font-mono">wom</code> o <code class="font-mono">pti</code>. Fila 1 = encabezado. Los técnicos importados quedan con activación pendiente.
      </p>
    </div>

  </div>

</div>
{% endblock %}
</file>

<file path="templates/manager/users_list.html">
{% extends "manager/base.html" %}
{% load humanize user_tags %}
{% block title %}Técnicos{% endblock %}

{% block content %}

<!-- Header + search -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl font-bold text-base-content tracking-tight">Técnicos</h1>
    <p class="text-xs text-base-content/40 mt-0.5">{{ page_obj.paginator.count|intcomma }} técnico(s)</p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <form method="get" class="flex items-center gap-2">
      <input type="search" name="q" value="{{ q }}"
             placeholder="Nombre o email…"
             class="input input-bordered input-sm h-9 w-48 text-sm">
      <button type="submit" class="btn btn-info btn-sm h-9 min-h-0 px-4 text-xs font-semibold">
        Buscar
      </button>
      {% if q %}
        <a href="{% url 'manager:users_list' %}" class="btn btn-ghost btn-sm h-9 min-h-0 text-xs text-base-content/50">
          Limpiar
        </a>
      {% endif %}
    </form>
    {% if request.user.role == 'super_manager' %}
      <a href="{% url 'manager:technician_import' %}" class="btn btn-secondary btn-sm h-9 min-h-0 text-xs">
        Importar Excel
      </a>
    {% endif %}
    {% if is_manager %}
      <a href="{% url 'manager:technician_create' %}" class="btn btn-success btn-sm h-9 min-h-0 px-4 text-xs font-semibold">
        + Agregar
      </a>
    {% endif %}
  </div>
</div>

{% if users %}

<!-- Mobile: cards -->
<div class="md:hidden space-y-3">
  {% for user in users %}
  <div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs p-4">
    <div class="flex items-start gap-3">
      {% if user.profile_photo and user.profile_photo.image %}
      <div class="w-12 h-12 rounded-full bg-cover bg-center shrink-0" style="background-image:url('{{ user.profile_photo.image.url }}');"></div>
      {% else %}
      <div class="w-12 h-12 rounded-full bg-info/10 flex items-center justify-center shrink-0">
        <span class="text-info text-sm font-bold">{{ user.get_full_name|default:user.email|initials }}</span>
      </div>
      {% endif %}
      <div class="min-w-0 flex-1">
        <div class="flex items-center justify-between gap-2">
          <p class="text-sm font-semibold text-base-content truncate">{{ user.get_full_name|default:"—" }}</p>
          {% if not is_manager %}
            {% if user.status == 1 %}
              <span class="badge badge-sm badge-outline badge-warning shrink-0">Pendiente</span>
            {% elif user.status == 2 %}
              <span class="badge badge-sm badge-outline badge-success shrink-0">Activo</span>
            {% else %}
              <span class="badge badge-sm badge-outline badge-error shrink-0">Inactivo</span>
            {% endif %}
          {% endif %}
        </div>
        <p class="text-xs text-base-content/40 mt-0.5 truncate">{{ user.email }}</p>
        {% if user.cargo %}
          <p class="text-xs text-base-content/30 mt-0.5">{{ user.cargo }}</p>
        {% endif %}
        <div class="flex flex-wrap items-center gap-1.5 mt-1.5">
          {% if user.company %}
            <span class="badge badge-xs badge-outline">{{ user.company|upper }}</span>
          {% endif %}
          {% if user.rut %}
            <span class="text-[10px] text-base-content/40 font-mono">{{ user.rut }}</span>
          {% endif %}
          {% if user.phone %}
            <span class="text-[10px] text-base-content/40">{{ user.phone }}</span>
          {% endif %}
        </div>
      </div>
    </div>
    {% if user.device %}
    <div class="mt-3 pt-3 border-t border-base-200">
      <p class="text-xs text-base-content/50">Dispositivo: <span class="text-base-content font-medium">{{ user.device.manufacturer }} {{ user.device.model }}</span></p>
      {% if user.device.android_id %}
      <p class="text-[10px] text-base-content/40 mt-0.5 font-mono">ID {{ user.device.android_id|slice:":8" }}…</p>
      {% endif %}
    </div>
    {% endif %}
    <div class="flex items-center justify-between mt-3 pt-3 border-t border-base-200">
      {% if is_manager %}
      <form method="post" action="{% url 'manager:technician_toggle' user.pk %}" class="inline-block">
        {% csrf_token %}
        {% if user.status == 1 %}
        <select name="status" onchange="this.form.submit()"
                style="-webkit-appearance:none;-moz-appearance:none;appearance:none;
                       border:1px solid #d97706;border-radius:9999px;
                       padding:1px 8px;font-size:11px;font-weight:500;
                       cursor:pointer;height:22px;line-height:1.2;outline:none;
                       background:transparent;color:#d97706;text-align:center;text-align-last:center;">
          <option value="active">Activo</option>
          <option value="pending" selected>Pendiente</option>
          <option value="inactive">Inactivo</option>
        </select>
        {% elif user.status == 2 %}
        <select name="status" onchange="this.form.submit()"
                style="-webkit-appearance:none;-moz-appearance:none;appearance:none;
                       border:1px solid #16a34a;border-radius:9999px;
                       padding:1px 8px;font-size:11px;font-weight:500;
                       cursor:pointer;height:22px;line-height:1.2;outline:none;
                       background:transparent;color:#16a34a;text-align:center;text-align-last:center;">
          <option value="active" selected>Activo</option>
          <option value="pending">Pendiente</option>
          <option value="inactive">Inactivo</option>
        </select>
        {% else %}
        <select name="status" onchange="this.form.submit()"
                style="-webkit-appearance:none;-moz-appearance:none;appearance:none;
                       border:1px solid #dc2626;border-radius:9999px;
                       padding:1px 8px;font-size:11px;font-weight:500;
                       cursor:pointer;height:22px;line-height:1.2;outline:none;
                       background:transparent;color:#dc2626;text-align:center;text-align-last:center;">
          <option value="active">Activo</option>
          <option value="pending">Pendiente</option>
          <option value="inactive" selected>Inactivo</option>
        </select>
        {% endif %}
      </form>
      {% else %}
      <span></span>
      {% endif %}
      <div class="flex items-center gap-0.5">
        <button type="button" class="inline-flex items-center justify-center w-7 h-7 text-view hover:opacity-70 transition-opacity"
                onclick="showTechnicianModal(this)"
                data-name="{{ user.get_full_name|default:'—'|escape }}"
                data-email="{{ user.email|escape }}"
                data-rut="{{ user.rut|default:'—' }}"
                data-phone="{{ user.phone|default:'—' }}"
                data-cargo="{{ user.cargo|default:'—' }}"
                data-company="{{ user.company|upper|default:'—' }}"
                data-status="{% if user.status == 1 %}Pendiente{% elif user.status == 2 %}Activo{% else %}Inactivo{% endif %}"
                data-avatar="{% if user.profile_photo and user.profile_photo.image %}{{ user.profile_photo.image.url }}{% endif %}"
                data-initials="{{ user.get_full_name|default:user.email|initials }}"
                data-device-manufacturer="{{ user.device.manufacturer|default:'' }}"
                data-device-model="{{ user.device.model|default:'' }}"
                data-device-fingerprint="{{ user.device.fingerprint|default:'' }}"
                data-device-android-id="{{ user.device.android_id|default:'' }}"
                data-device-os="{{ user.device.os_version|default:'' }}"
                data-device-registered="{{ user.device.registered_at|date:'d/m/Y H:i'|default:'' }}"
                data-authorized-by="{% if user.status_changed_by %}{{ user.status_changed_by.get_full_name|default:user.status_changed_by.email|escape }}{% endif %}"
                data-authorized-at="{{ user.status_changed_at|date:'d/m/Y H:i'|default:'' }}"
                data-date-joined="{{ user.date_joined|date:'d/m/Y H:i' }}"
                data-last-login="{{ user.last_login|date:'d/m/Y H:i'|default:'—' }}"
                title="Ver información">
          <i class="fa-solid fa-circle-info"></i>
        </button>
        {% if is_manager %}
        <a href="{% url 'manager:technician_edit' user.pk %}"
           class="inline-flex items-center justify-center w-7 h-7 text-edit hover:opacity-70 transition-opacity" title="Editar">
          <i class="fa-solid fa-pen"></i>
        </a>
        <a href="{% url 'manager:technician_delete' user.pk %}"
           class="inline-flex items-center justify-center w-7 h-7 text-delete hover:opacity-70 transition-opacity" title="Eliminar">
          <i class="fa-solid fa-trash-can"></i>
        </a>
        {% endif %}
      </div>
    </div>
  </div>
  {% endfor %}
</div>

<!-- Desktop: table -->
<div class="hidden md:block bg-base-100 rounded-2xl border border-base-300 shadow-xs overflow-hidden">
  <div class="overflow-x-auto">
    <table class="table table-sm">
      <thead>
        <tr>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Técnico</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Empresa</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">RUT</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Teléfono</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Dispositivo</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide text-center">Estado</th>
          {% if is_manager %}
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide"></th>
          {% endif %}
        </tr>
      </thead>
      <tbody>
        {% for user in users %}
        <tr class="hover:bg-primary/5 transition-colors">
          <td class="py-3.5">
            <div class="flex items-center gap-3">
              {% if user.profile_photo and user.profile_photo.image %}
              <div class="w-12 h-12 rounded-full bg-cover bg-center shrink-0" style="background-image:url('{{ user.profile_photo.image.url }}');"></div>
              {% else %}
              <div class="w-12 h-12 rounded-full bg-info/10 flex items-center justify-center shrink-0">
                <span class="text-info text-sm font-bold">{{ user.get_full_name|default:user.email|initials }}</span>
              </div>
              {% endif %}
              <div>
                <p class="text-sm font-medium text-base-content">{{ user.get_full_name|default:"—" }}</p>
                <p class="text-xs text-base-content/40 mt-0.5">{{ user.email }}</p>
                {% if user.cargo %}
                  <p class="text-xs text-base-content/30">{{ user.cargo }}</p>
                {% endif %}
              </div>
            </div>
          </td>
          <td class="py-3.5">
            {% if user.company %}
              <span class="badge badge-sm badge-outline">{{ user.company|upper }}</span>
            {% else %}
              <span class="text-base-content/30 text-xs">—</span>
            {% endif %}
          </td>
          <td class="py-3.5 font-mono text-sm text-base-content/60">
            {{ user.rut|default:"—" }}
          </td>
          <td class="py-3.5 text-sm text-base-content/60">
            {{ user.phone|default:"—" }}
          </td>
          <td class="py-3.5">
            {% if user.device %}
              <p class="text-xs font-medium text-base-content">{{ user.device.manufacturer }} {{ user.device.model }}</p>
              {% if user.device.android_id %}
              <p class="text-xs text-base-content/40 mt-0.5 font-mono">{{ user.device.android_id|slice:":8" }}…</p>
              {% endif %}
            {% else %}
              <span class="text-xs text-base-content/30">Sin dispositivo</span>
            {% endif %}
          </td>
          <td class="py-3.5 text-center">
            {% if is_manager %}
            <form method="post" action="{% url 'manager:technician_toggle' user.pk %}" class="inline-block">
              {% csrf_token %}
              {% if user.status == 1 %}
              <select name="status" onchange="this.form.submit()"
                      style="-webkit-appearance:none;-moz-appearance:none;appearance:none;
                             border:1px solid #d97706;border-radius:9999px;
                             padding:1px 8px;font-size:11px;font-weight:500;
                             cursor:pointer;height:22px;line-height:1.2;outline:none;
                             background:transparent;color:#d97706;text-align:center;text-align-last:center;">
                <option value="active">Activo</option>
                <option value="pending" selected>Pendiente</option>
                <option value="inactive">Inactivo</option>
              </select>
              {% elif user.status == 2 %}
              <select name="status" onchange="this.form.submit()"
                      style="-webkit-appearance:none;-moz-appearance:none;appearance:none;
                             border:1px solid #16a34a;border-radius:9999px;
                             padding:1px 8px;font-size:11px;font-weight:500;
                             cursor:pointer;height:22px;line-height:1.2;outline:none;
                             background:transparent;color:#16a34a;text-align:center;text-align-last:center;">
                <option value="active" selected>Activo</option>
                <option value="pending">Pendiente</option>
                <option value="inactive">Inactivo</option>
              </select>
              {% else %}
              <select name="status" onchange="this.form.submit()"
                      style="-webkit-appearance:none;-moz-appearance:none;appearance:none;
                             border:1px solid #dc2626;border-radius:9999px;
                             padding:1px 8px;font-size:11px;font-weight:500;
                             cursor:pointer;height:22px;line-height:1.2;outline:none;
                             background:transparent;color:#dc2626;text-align:center;text-align-last:center;">
                <option value="active">Activo</option>
                <option value="pending">Pendiente</option>
                <option value="inactive" selected>Inactivo</option>
              </select>
              {% endif %}
            </form>
            {% else %}
              {% if user.status == 1 %}
                <span class="badge badge-sm badge-outline badge-warning">Pendiente</span>
              {% elif user.status == 2 %}
                <span class="badge badge-sm badge-outline badge-success">Activo</span>
              {% else %}
                <span class="badge badge-sm badge-outline badge-error">Inactivo</span>
              {% endif %}
            {% endif %}
          </td>
          {% if is_manager %}
          <td class="py-3.5 text-right whitespace-nowrap">
            <button type="button" class="inline-flex items-center justify-center w-7 h-7 text-view hover:opacity-70 transition-opacity"
                    onclick="showTechnicianModal(this)"
                    data-name="{{ user.get_full_name|default:'—'|escape }}"
                    data-email="{{ user.email|escape }}"
                    data-rut="{{ user.rut|default:'—' }}"
                    data-phone="{{ user.phone|default:'—' }}"
                    data-cargo="{{ user.cargo|default:'—' }}"
                    data-company="{{ user.company|upper|default:'—' }}"
                    data-status="{% if user.status == 1 %}Pendiente{% elif user.status == 2 %}Activo{% else %}Inactivo{% endif %}"
                    data-avatar="{% if user.profile_photo and user.profile_photo.image %}{{ user.profile_photo.image.url }}{% endif %}"
                    data-initials="{{ user.get_full_name|default:user.email|initials }}"
                    data-device-manufacturer="{{ user.device.manufacturer|default:'' }}"
                    data-device-model="{{ user.device.model|default:'' }}"
                    data-device-fingerprint="{{ user.device.fingerprint|default:'' }}"
                    data-device-android-id="{{ user.device.android_id|default:'' }}"
                    data-device-os="{{ user.device.os_version|default:'' }}"
                    data-device-registered="{{ user.device.registered_at|date:'d/m/Y H:i'|default:'' }}"
                    data-authorized-by="{% if user.status_changed_by %}{{ user.status_changed_by.get_full_name|default:user.status_changed_by.email|escape }}{% endif %}"
                    data-authorized-at="{{ user.status_changed_at|date:'d/m/Y H:i'|default:'' }}"
                    data-date-joined="{{ user.date_joined|date:'d/m/Y H:i' }}"
                    data-last-login="{{ user.last_login|date:'d/m/Y H:i'|default:'—' }}"
                    title="Ver información">
              <i class="fa-solid fa-circle-info"></i>
            </button>
            <a href="{% url 'manager:technician_edit' user.pk %}"
               class="inline-flex items-center justify-center w-7 h-7 text-edit hover:opacity-70 transition-opacity" title="Editar">
              <i class="fa-solid fa-pen"></i>
            </a>
            <a href="{% url 'manager:technician_delete' user.pk %}"
               class="inline-flex items-center justify-center w-7 h-7 text-delete hover:opacity-70 transition-opacity" title="Eliminar">
              <i class="fa-solid fa-trash-can"></i>
            </a>
          </td>
          {% endif %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% if page_obj.has_other_pages %}
<div class="flex justify-center items-center mt-6 gap-2">
  {% if page_obj.has_previous %}
    <a href="?q={{ q }}&page={{ page_obj.previous_page_number }}"
       class="btn btn-ghost btn-sm border border-base-300 text-secondary/60 h-9 min-h-0">‹</a>
  {% endif %}
  <span class="text-sm text-base-content/50 px-3">
    {{ page_obj.number }} / {{ page_obj.paginator.num_pages }}
  </span>
  {% if page_obj.has_next %}
    <a href="?q={{ q }}&page={{ page_obj.next_page_number }}"
       class="btn btn-ghost btn-sm border border-base-300 text-secondary/60 h-9 min-h-0">›</a>
  {% endif %}
</div>
{% endif %}

{% else %}
<div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs">
  <div class="flex flex-col items-center justify-center py-20 px-8 text-center">
    <div class="w-12 h-12 rounded-2xl bg-base-200 flex items-center justify-center mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
    </div>
    <p class="text-sm font-medium text-base-content/40">
      {% if q %}No se encontraron técnicos{% else %}Sin técnicos registrados{% endif %}
    </p>
    {% if is_manager and not q %}
      <a href="{% url 'manager:technician_create' %}" class="btn btn-success btn-sm mt-4 text-xs font-semibold">+ Agregar técnico</a>
    {% endif %}
  </div>
</div>
{% endif %}

<!-- Technician info modal -->
<dialog id="technician-modal" class="modal">
  <div class="modal-box max-w-sm p-0 overflow-hidden">
    <div class="flex items-center gap-4 p-6 pb-4">
      <div id="modal-avatar" class="w-16 h-16 rounded-full bg-info/10 flex items-center justify-center shrink-0">
        <span id="modal-initials" class="text-info text-xl font-bold"></span>
      </div>
      <div class="min-w-0">
        <h3 id="modal-name" class="text-lg font-bold text-base-content truncate"></h3>
        <p id="modal-email" class="text-xs text-base-content/50 truncate mt-0.5"></p>
        <p id="modal-status" class="mt-1"></p>
      </div>
    </div>
    <div class="px-6 pb-6 space-y-3">
      <div class="grid grid-cols-2 gap-3 text-sm">
        <div><span class="text-base-content/40 text-xs">RUT</span><p id="modal-rut" class="text-base-content font-medium">—</p></div>
        <div><span class="text-base-content/40 text-xs">Teléfono</span><p id="modal-phone" class="text-base-content font-medium">—</p></div>
        <div><span class="text-base-content/40 text-xs">Cargo</span><p id="modal-cargo" class="text-base-content font-medium">—</p></div>
        <div><span class="text-base-content/40 text-xs">Empresa</span><p id="modal-company" class="text-base-content font-medium">—</p></div>
      </div>
      <div class="border-t border-base-200 pt-3">
        <p class="text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-2">Dispositivo</p>
        <div id="modal-device-info" class="text-sm text-base-content space-y-1">
          <p id="modal-device-empty" class="text-base-content/40 text-xs">Sin dispositivo registrado</p>
          <div id="modal-device-details" class="hidden space-y-1">
            <p><span class="text-base-content/40">Modelo:</span> <span id="modal-device-model" class="font-medium"></span></p>
            <p><span class="text-base-content/40">Android ID:</span> <span id="modal-device-android-id" class="font-mono text-xs break-all"></span></p>
            <p><span class="text-base-content/40">Fingerprint:</span> <span id="modal-device-fingerprint" class="font-mono text-xs break-all"></span></p>
            <p><span class="text-base-content/40">OS:</span> <span id="modal-device-os"></span></p>
            <p><span class="text-base-content/40">Registrado:</span> <span id="modal-device-registered"></span></p>
          </div>
        </div>
      </div>
      <div class="border-t border-base-200 pt-3 grid grid-cols-2 gap-3 text-sm">
        <div><span class="text-base-content/40 text-xs">Cuenta creada</span><p id="modal-date-joined" class="text-base-content font-medium text-xs">—</p></div>
        <div><span class="text-base-content/40 text-xs">Último acceso</span><p id="modal-last-login" class="text-base-content font-medium text-xs">—</p></div>
      </div>
      <div id="modal-authorized-wrap" class="hidden border-t border-base-200 pt-3">
        <p class="flex items-center gap-1.5 text-xs text-base-content/40">
          <i class="fa-solid fa-user-check shrink-0"></i>
          Autorizado por
          <span id="modal-authorized-by" class="font-medium text-base-content/60"></span>
          <span id="modal-authorized-at" class="text-base-content/30"></span>
        </p>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>

<script>
function showTechnicianModal(btn) {
  var d = btn.dataset;
  var m = document.getElementById('technician-modal');

  document.getElementById('modal-name').textContent = d.name;
  document.getElementById('modal-email').textContent = d.email;
  document.getElementById('modal-rut').textContent = d.rut;
  document.getElementById('modal-phone').textContent = d.phone;
  document.getElementById('modal-cargo').textContent = d.cargo;
  document.getElementById('modal-company').textContent = d.company;
  document.getElementById('modal-date-joined').textContent = d.dateJoined;
  document.getElementById('modal-last-login').textContent = d.lastLogin;

  var authorizedWrap = document.getElementById('modal-authorized-wrap');
  if (d.authorizedBy) {
    document.getElementById('modal-authorized-by').textContent = d.authorizedBy;
    document.getElementById('modal-authorized-at').textContent = d.authorizedAt ? '· ' + d.authorizedAt : '';
    authorizedWrap.classList.remove('hidden');
  } else {
    authorizedWrap.classList.add('hidden');
  }

  var statusEl = document.getElementById('modal-status');
  var status = d.status;
  if (status === 'Activo') {
    statusEl.innerHTML = '<span class="badge badge-sm badge-outline badge-success">Activo</span>';
  } else if (status === 'Pendiente') {
    statusEl.innerHTML = '<span class="badge badge-sm badge-outline badge-warning">Pendiente</span>';
  } else {
    statusEl.innerHTML = '<span class="badge badge-sm badge-outline badge-error">Inactivo</span>';
  }

  if (d.avatar) {
    document.getElementById('modal-avatar').style.backgroundImage = "url('" + d.avatar + "')";
    document.getElementById('modal-avatar').style.backgroundSize = 'cover';
    document.getElementById('modal-avatar').style.backgroundPosition = 'center';
    document.getElementById('modal-initials').style.display = 'none';
  } else {
    document.getElementById('modal-avatar').style.backgroundImage = '';
    document.getElementById('modal-avatar').style.backgroundSize = '';
    document.getElementById('modal-avatar').style.backgroundPosition = '';
    document.getElementById('modal-initials').style.display = '';
    document.getElementById('modal-initials').textContent = d.initials;
  }

  if (d.deviceManufacturer) {
    document.getElementById('modal-device-empty').classList.add('hidden');
    document.getElementById('modal-device-details').classList.remove('hidden');
    document.getElementById('modal-device-model').textContent = d.deviceManufacturer + ' ' + d.deviceModel;
    document.getElementById('modal-device-android-id').textContent = d.deviceAndroidId || '—';
    document.getElementById('modal-device-fingerprint').textContent = d.deviceFingerprint;
    document.getElementById('modal-device-os').textContent = d.deviceOs || '—';
    document.getElementById('modal-device-registered').textContent = d.deviceRegistered || '—';
  } else {
    document.getElementById('modal-device-empty').classList.remove('hidden');
    document.getElementById('modal-device-details').classList.add('hidden');
  }

  m.showModal();
}
</script>

{% endblock %}
</file>

<file path="templates/manager/visit_detail.html">
{% extends "manager/base.html" %}
{% block title %}Visita #{{ visit_number }}{% endblock %}

{% block extra_head %}
{% if tracking_points_geo %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">
{% endif %}
{% endblock %}

{% block content %}

<!-- Back -->
<div class="mb-5">
  <a href="{% url 'manager:visits_approval' %}"
     class="inline-flex items-center gap-1.5 text-sm text-base-content/50 hover:text-primary transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
    </svg>
    Volver a visitas
  </a>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

  <!-- Left column -->
  <div class="lg:col-span-1 flex flex-col gap-4">

    <!-- Sitio card -->
    <div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs overflow-hidden">
      <div class="px-5 py-3 border-b border-base-200">
        <p class="text-xs font-semibold text-base-content/40 uppercase tracking-wide">Sitio</p>
      </div>
      <div class="divide-y divide-base-200">
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Código</span>
          <span class="text-sm font-mono font-bold text-base-content">{{ visit.site.code }}</span>
        </div>
        {% if visit.site.operator_code %}
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Cód. Operador</span>
          <span class="text-sm font-mono text-base-content/70">{{ visit.site.operator_code }}</span>
        </div>
        {% endif %}
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Nombre</span>
          <span class="text-sm text-base-content">{{ visit.site.name }}</span>
        </div>
      </div>
    </div><!-- /sitio card -->

    <!-- Visita card -->
    <div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs overflow-hidden">

      <!-- Card header -->
      <div class="px-5 py-4 border-b border-base-200 flex items-center justify-between">
        <div>
          <p class="text-xs font-semibold text-base-content/40 uppercase tracking-wide">Visita</p>
          <h2 class="text-lg font-bold text-base-content tracking-tight">#{{ visit_number }}</h2>
        </div>
        {% if visit.status == 'completada' %}
        <div class="indicator">
          {% if visit.photos.count %}
          <span class="indicator-item badge badge-xs badge-info font-mono font-bold !text-black">{{ visit.photos.count }}</span>
          {% endif %}
          <span class="badge badge-outline badge-success badge-md font-medium">{{ visit.get_status_display }}</span>
        </div>
        {% else %}
        <div class="inline-flex items-center gap-1">
          <span class="badge badge-outline badge-md font-medium
            {% if visit.status == 'pendiente_aprobacion' %}badge-warning
            {% elif visit.status == 'programada' %}badge-info
            {% elif visit.status == 'en_camino' or visit.status == 'llegada' %}badge-info
            {% elif visit.status == 'trabajando' or visit.status == 'finalizando' %}badge-warning
            {% elif visit.status == 'cancelada' %}badge-error
            {% elif visit.status == 'rechazada' %}badge-error
            {% else %}badge-ghost{% endif %}">
            {{ visit.get_status_display }}
          </span>
          {% if visit.status == 'en_camino' %}<span class="text-[10px] text-base-content/40 font-mono">2/5</span>
          {% elif visit.status == 'llegada' %}<span class="text-[10px] text-base-content/40 font-mono">3/5</span>
          {% elif visit.status == 'trabajando' %}<span class="text-[10px] text-base-content/40 font-mono">4/5</span>
          {% endif %}
        </div>
        {% endif %}
      </div>

      <!-- Details list -->
      <div class="divide-y divide-base-200">
        {% if visit.coordinator %}
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Coordinador</span>
          <span class="text-sm text-base-content">{{ visit.coordinator.get_full_name|default:visit.coordinator.email }}</span>
        </div>
        {% endif %}
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Técnico</span>
          <span class="text-sm text-base-content">{{ visit.technician.get_full_name|default:visit.technician.email }}</span>
        </div>
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Empresa</span>
          <span class="badge badge-sm badge-outline">{{ visit.technician.company|upper }}</span>
        </div>
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Fecha</span>
          <span class="text-sm text-base-content">{{ visit.scheduled_date|date:"d-m-y" }}, {{ visit.scheduled_date|date:"l" }}</span>
        </div>
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Objetivo</span>
          <span class="text-sm text-base-content">{{ visit.reason }}</span>
        </div>
        {% if visit.eta %}
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">H. Est. Llegada</span>
          <span class="text-sm text-base-content font-mono">{{ visit.eta|time:"H:i" }}</span>
        </div>
        {% endif %}
        {% if visit.hora_inicio_trabajos %}
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Inicio</span>
          <span class="text-sm text-base-content">{{ visit.hora_inicio_trabajos|date:"d/m/Y H:i" }}</span>
        </div>
        {% endif %}
        {% if visit.hora_fin_trabajos %}
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Fin</span>
          <span class="text-sm text-base-content">{{ visit.hora_fin_trabajos|date:"d/m/Y H:i" }}</span>
        </div>
        {% endif %}
        {% if visit.hora_inicio_trabajos and visit.hora_fin_trabajos %}
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Duración</span>
          <span class="text-sm font-semibold text-base-content">{{ visit_duration }}</span>
        </div>
        {% endif %}
        {% if visit.notas %}
        <div class="flex items-start gap-3 px-5 py-3">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Comentario/Obs.</span>
          <span class="text-sm text-base-content whitespace-pre-wrap">{{ visit.notas }}</span>
        </div>
        {% endif %}

        <!-- Auditoría de aprobación -->
        {% if visit.approved_at %}
        <div class="flex items-start gap-3 px-5 py-3 bg-success/5">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Aprobado por</span>
          <div>
            <p class="text-sm text-base-content">{{ visit.approved_by.get_full_name|default:visit.approved_by.email|default:"—" }}</p>
            <p class="text-xs text-base-content/40 mt-0.5">{{ visit.approved_at|date:"d/m/Y H:i" }}</p>
          </div>
        </div>
        {% endif %}
        {% if visit.rejected_at %}
        <div class="flex items-start gap-3 px-5 py-3 bg-error/5">
          <span class="text-xs font-medium text-base-content/40 w-24 shrink-0 pt-0.5">Rechazado por</span>
          <div>
            <p class="text-sm text-base-content">{{ visit.rejected_by.get_full_name|default:visit.rejected_by.email|default:"—" }}</p>
            <p class="text-xs text-base-content/40 mt-0.5">{{ visit.rejected_at|date:"d/m/Y H:i" }}</p>
            {% if visit.rejection_reason %}
            <p class="text-xs text-error mt-1">{{ visit.rejection_reason }}</p>
            {% endif %}
          </div>
        </div>
        {% endif %}

      </div>

      <!-- Acciones de aprobación (solo super_manager + estado pendiente) -->
      {% if visit.status == 'pendiente_aprobacion' and request.user.role == 'super_manager' %}
      <div class="px-5 py-4 border-t border-base-200 flex items-center gap-2">
        <form method="post" action="{% url 'manager:visit_approve' pk=visit.pk %}">
          {% csrf_token %}
          <button type="submit" class="btn btn-success btn-sm h-9 min-h-0">
            <i class="fa-solid fa-check text-xs"></i>
            Aprobar servicio
          </button>
        </form>
        <button onclick="document.getElementById('reject-visit-detail-{{ visit.pk }}').showModal()"
                class="btn btn-ghost btn-sm h-9 min-h-0 text-error hover:bg-error/8">
          <i class="fa-solid fa-xmark text-xs"></i>
          Rechazar
        </button>
      </div>
      {% endif %}

    </div><!-- /visita card -->

    <!-- Modal de rechazo desde detalle -->
    {% if visit.status == 'pendiente_aprobacion' and request.user.role == 'super_manager' %}
    <dialog id="reject-visit-detail-{{ visit.pk }}" class="modal modal-bottom sm:modal-middle">
      <div class="modal-box shadow-xl">
        <h3 class="font-bold text-base text-base-content">Rechazar servicio</h3>
        <p class="text-sm text-base-content/50 mt-1 mb-4">
          Servicio para <strong class="text-base-content">{{ visit.technician.get_full_name }}</strong>
          en <strong class="text-base-content">{{ visit.site.code }}</strong>.
        </p>
        <form method="post" action="{% url 'manager:visit_reject' pk=visit.pk %}">
          {% csrf_token %}
          <div class="mb-4">
            <label class="block text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-2">
              Motivo de rechazo *
            </label>
            <textarea name="rejection_reason"
                      required
                      minlength="3"
                      rows="3"
                      placeholder="Indica el motivo…"
                      class="textarea textarea-bordered w-full text-sm resize-none"></textarea>
          </div>
          <div class="modal-action">
            <button type="button" onclick="this.closest('dialog').close()"
                    class="btn btn-ghost btn-sm text-base-content/50">Cancelar</button>
            <button type="submit" class="btn btn-delete btn-sm">Rechazar servicio</button>
          </div>
        </form>
      </div>
      <form method="dialog" class="modal-backdrop"><button>close</button></form>
    </dialog>
    {% endif %}

    <!-- GPS Tracking -->
    <div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs overflow-hidden">
      <div class="px-5 py-4 border-b border-base-200 flex items-center justify-between">
        <h3 class="text-sm font-semibold text-base-content">Tracking GPS</h3>
        <span class="text-xs font-medium text-base-content/40">{{ visit.tracking_points.count }} evento(s)</span>
      </div>
      <div class="px-5 py-3">
        {% if visit.tracking_points.all %}
        <div class="flex flex-col gap-0">
          {% for pt in visit.tracking_points.all %}
          <div class="flex items-stretch gap-3">

            <!-- Tiempo (columna fija izquierda) -->
            <div class="w-10 shrink-0 flex flex-col items-end justify-start pt-2.5">
              <p class="text-xs font-mono font-semibold text-base-content/70 leading-none">{{ pt.timestamp|date:"H:i" }}</p>
              <p class="text-[9px] text-base-content/30 mt-0.5 leading-none">{{ pt.timestamp|date:"d/m" }}</p>
            </div>

            <!-- Conector vertical + icono -->
            <div class="flex flex-col items-center shrink-0" style="width:20px">
              <!-- Línea superior (oculta en el primero) -->
              <div class="w-px flex-none {% if forloop.first %}invisible{% endif %} bg-base-300" style="height:10px"></div>
              <!-- Icono del paso -->
              <div class="w-5 h-5 rounded-full shrink-0 flex items-center justify-center
                {% if pt.event == 'salida' %}bg-info/15
                {% elif pt.event == 'llegada' %}bg-warning/15
                {% elif pt.event == 'inicio' %}bg-success/15
                {% elif pt.event == 'cierre' %}bg-delete/15
                {% elif pt.event == 'finalizado' %}bg-primary/15
                {% else %}bg-base-300{% endif %}">
                {% if pt.event == 'salida' %}<i class="fa-solid fa-car text-[8px] text-info"></i>
                {% elif pt.event == 'llegada' %}<i class="fa-solid fa-location-dot text-[8px] text-warning"></i>
                {% elif pt.event == 'inicio' %}<i class="fa-solid fa-wrench text-[8px] text-success"></i>
                {% elif pt.event == 'cierre' %}<i class="fa-solid fa-flag-checkered text-[8px] text-primary"></i>
                {% elif pt.event == 'finalizado' %}<i class="fa-solid fa-screwdriver-wrench text-[8px] text-delete"></i>
                {% else %}<i class="fa-solid fa-circle text-[8px] text-base-content/30"></i>
                {% endif %}
              </div>
              <!-- Línea inferior (oculta en el último) -->
              <div class="w-px flex-1 mt-1 {% if forloop.last %}invisible{% endif %} bg-base-300"></div>
            </div>

            <!-- Card del evento (inmediatamente a la derecha de hora/fecha) -->
            <div class="flex-1 border border-base-200 rounded-xl px-3 py-2 mb-2.5 bg-base-50 self-start">
              <div class="flex items-center gap-1.5">
                <p class="text-xs font-semibold text-base-content">
                  {% if pt.event == 'salida' %}Movilización
                  {% elif pt.event == 'llegada' %}Llegada
                  {% elif pt.event == 'inicio' %}Inicio
                  {% elif pt.event == 'cierre' %}Cierre
                  {% elif pt.event == 'finalizado' %}Finalizado
                  {% else %}{{ pt.get_event_display }}{% endif %}
                </p>
                <span class="text-[9px] text-base-content/30 font-normal">— {{ pt.get_event_display }}</span>
              </div>
              <a href="https://www.google.com/maps/search/?api=1&query={{ pt.latitude|stringformat:'.6f' }},{{ pt.longitude|stringformat:'.6f' }}"
                 target="_blank"
                 class="text-[10px] text-info hover:underline font-mono mt-0.5 block">
                {{ pt.latitude|stringformat:".5f" }}, {{ pt.longitude|stringformat:".5f" }}
              </a>
            </div>

          </div>
          {% endfor %}
        </div>
        {% else %}
        <div class="flex flex-col items-center justify-center py-8 text-center">
          <i class="fa-solid fa-location-crosshairs text-2xl text-base-content/15 mb-2"></i>
          <p class="text-xs text-base-content/30">Sin eventos GPS registrados</p>
        </div>
        {% endif %}
      </div>
    </div>

  </div><!-- /left column -->

  <!-- Right column: photos -->
  <div class="lg:col-span-2">
    <div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs overflow-hidden">
      <div class="px-5 py-4 border-b border-base-200 flex items-center justify-between">
        <h3 class="text-sm font-semibold text-base-content">Imágenes</h3>
        <span class="text-xs font-medium text-base-content/40">{{ visit.photos.count }} imagen(es)</span>
      </div>
      <div class="p-5">
        {% if visit.photos.all %}
          <div class="grid grid-cols-3 md:grid-cols-4 gap-2">
            {% for photo in visit.photos.all %}
            <div>
              <button type="button" class="block w-full" onclick="openLightbox('{{ photo.image.url }}', '{{ photo.get_photo_type_display }}')">
                <img src="{{ photo.image.url }}"
                     alt="{{ photo.get_photo_type_display }}"
                     class="w-full aspect-square object-cover rounded-xl border border-base-200 hover:border-primary/30 hover:shadow-md transition-all duration-150 cursor-zoom-in">
              </button>
              <div class="mt-1.5 flex items-center gap-1.5 flex-wrap">
                <span class="badge badge-sm badge-ghost text-xs">{{ photo.description|default:photo.get_photo_type_display }}</span>
                {% if photo.taken_at %}
                  <span class="text-xs text-base-content/40">{{ photo.taken_at|date:"d/m H:i" }}</span>
                {% endif %}
              </div>
            </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="flex flex-col items-center justify-center py-12 text-center">
            <div class="w-10 h-10 rounded-xl bg-base-200 flex items-center justify-center mb-3">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <p class="text-sm text-base-content/30">Sin imágenes registradas</p>
          </div>
        {% endif %}
      </div>
    </div>

    <!-- Mapa de ruta (debajo de imágenes, solo si hay tracking points) -->
    {% if tracking_points_geo %}
    <div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs overflow-hidden mt-4">
      <div class="px-5 py-3.5 border-b border-base-200 flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-info/10 flex items-center justify-center">
          <i class="fa-solid fa-map text-[11px] text-info"></i>
        </div>
        <h3 class="text-sm font-semibold text-base-content">Mapa de ruta</h3>
      </div>
      <div id="visit-map" style="height:400px;"></div>
    </div>
    {% endif %}

  </div>

</div><!-- /grid -->

<!-- Lightbox modal -->
<dialog id="lightbox" class="modal">
  <div class="modal-box max-w-4xl p-0 bg-transparent shadow-none overflow-visible">
    <div class="relative">
      <button type="button" onclick="document.getElementById('lightbox').close()"
              class="absolute -top-3 -right-3 z-10 w-8 h-8 rounded-full bg-base-100 border border-base-300 shadow flex items-center justify-center hover:bg-base-200 transition-colors">
        <i class="fa-solid fa-xmark text-sm text-base-content/70"></i>
      </button>
      <img id="lightbox-img" src="" alt=""
           class="w-full max-h-[80vh] object-contain rounded-2xl shadow-2xl bg-base-900">
      <p id="lightbox-caption" class="text-center text-xs text-white/70 mt-2"></p>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop bg-black/70">
    <button>close</button>
  </form>
</dialog>

<script>
function openLightbox(url, caption) {
  document.getElementById('lightbox-img').src = url;
  document.getElementById('lightbox-caption').textContent = caption;
  document.getElementById('lightbox').showModal();
}
document.getElementById('lightbox').addEventListener('click', function(e) {
  if (e.target === this) this.close();
});
</script>

{% endblock %}

{% block extra_scripts %}
{% if tracking_points_geo %}
{{ site_geo|json_script:"visit-site-data" }}
{{ tracking_points_geo|json_script:"visit-tracking-data" }}
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
(function () {
  'use strict';
  var siteData   = JSON.parse(document.getElementById('visit-site-data').textContent);
  var trackData  = JSON.parse(document.getElementById('visit-tracking-data').textContent);
  if (!trackData.length) return;

  var cs = getComputedStyle(document.documentElement);
  function cssVar(name) { return cs.getPropertyValue(name).trim(); }

  var primaryColor   = cssVar('--color-primary')   || '#E6007E';
  var secondaryColor = cssVar('--color-secondary')  || '#3B82F6';
  var infoColor      = cssVar('--color-info')       || '#3B82F6';
  var warningColor   = cssVar('--color-warning')    || '#F59E0B';
  var successColor   = cssVar('--color-success')    || '#10B981';

  var map = L.map('visit-map', { zoomControl: true });
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap',
    maxZoom: 19,
  }).addTo(map);

  // Icono del sitio — globo tipo Leaflet
  function siteIcon() {
    var color = secondaryColor || primaryColor;
    var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="30" height="44" viewBox="0 0 26 38" style="filter:drop-shadow(0 2px 5px rgba(0,0,0,0.35));">'
            + '<path d="M13 0C5.82 0 0 5.82 0 13C0 22.75 13 38 13 38S26 22.75 26 13C26 5.82 20.18 0 13 0Z" fill="' + color + '"/>'
            + '<circle cx="13" cy="12" r="6.5" fill="rgba(255,255,255,0.88)"/>'
            + '</svg>';
    return L.divIcon({
      className: '',
      iconSize: [30, 44],
      iconAnchor: [15, 44],
      popupAnchor: [0, -46],
      html: svg,
    });
  }

  // Icono de tracking point numerado
  var eventColors = { salida: infoColor, llegada: warningColor, inicio: successColor, cierre: primaryColor, finalizado: primaryColor };
  function trackIcon(n, event) {
    var color = eventColors[event] || '#6B7280';
    return L.divIcon({
      className: '',
      iconSize: [26, 26],
      iconAnchor: [13, 13],
      popupAnchor: [0, -14],
      html: '<div style="width:26px;height:26px;border-radius:50%;background:' + color + ';display:flex;align-items:center;justify-content:center;box-shadow:0 1px 6px rgba(0,0,0,0.25);border:2px solid white;">'
           + '<span style="color:white;font-size:9px;font-weight:700;line-height:1;">' + n + '</span></div>',
    });
  }

  var bounds = [];

  // Marcador del sitio
  var siteLat = siteData.lat, siteLng = siteData.lng;
  L.marker([siteLat, siteLng], { icon: siteIcon() })
    .addTo(map)
    .bindPopup('<strong style="font-size:13px;">' + siteData.code + '</strong><br><span style="font-size:12px;color:#555;">' + siteData.name + '</span>');
  bounds.push([siteLat, siteLng]);

  // Polyline de la ruta
  var latlngs = trackData.map(function (p) { return [p.lat, p.lng]; });
  L.polyline(latlngs, { color: primaryColor, weight: 3, opacity: 0.7, dashArray: null }).addTo(map);

  // Marcadores de tracking points
  trackData.forEach(function (pt, i) {
    var ts = new Date(pt.timestamp);
    var timeStr = ts.toLocaleTimeString('es-CL', { hour: '2-digit', minute: '2-digit' });
    var dateStr = ts.toLocaleDateString('es-CL', { day: '2-digit', month: '2-digit' });
    L.marker([pt.lat, pt.lng], { icon: trackIcon(i + 1, pt.event) })
      .addTo(map)
      .bindPopup(
        '<strong style="font-size:12px;">' + pt.event_display + '</strong><br>'
        + '<span style="font-size:11px;color:#888;">' + dateStr + ' ' + timeStr + '</span><br>'
        + '<span style="font-size:10px;font-family:monospace;color:#aaa;">' + pt.lat.toFixed(5) + ', ' + pt.lng.toFixed(5) + '</span>'
      );
    bounds.push([pt.lat, pt.lng]);
  });

  map.fitBounds(bounds, { padding: [24, 24] });

  // Actualizar colores si cambia el tema
  new MutationObserver(function () {
    var c = getComputedStyle(document.documentElement);
    primaryColor   = c.getPropertyValue('--color-primary').trim()   || '#E6007E';
    secondaryColor = c.getPropertyValue('--color-secondary').trim()  || '#3B82F6';
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
})();
</script>
{% endif %}
{% endblock %}
</file>

<file path="templates/manager/visit_form.html">
{% extends "manager/base.html" %}
{% block title %}{% if is_edit %}Editar Servicio #{{ visit.pk }}{% else %}Nueva Visita{% endif %}{% endblock %}

{% block content %}

<!-- Header -->
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-bold text-base-content tracking-tight">
      {% if is_edit %}Editar Servicio #{{ visit.pk }}{% else %}Nueva Visita{% endif %}
    </h1>
    {% if not is_edit %}
      {% if request.user.role == 'super_manager' %}
      <p class="text-xs text-base-content/40 mt-0.5">Como manager, el servicio se aprueba automáticamente al crearlo.</p>
      {% else %}
      <p class="text-xs text-base-content/40 mt-0.5">El servicio quedará pendiente de aprobación del manager antes de asignarse al técnico.</p>
      {% endif %}
    {% endif %}
  </div>
  <a href="{% url 'manager:visits_approval' %}" class="btn btn-ghost btn-sm h-9 min-h-0 text-base-content/50">
    <i class="fa-solid fa-arrow-left text-xs"></i>
    Volver
  </a>
</div>

<form method="post" class="max-w-2xl" id="visit-form"
      {% if is_edit %}action="{% url 'manager:visit_edit' visit.pk %}"{% endif %}>
  {% csrf_token %}

  <div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs divide-y divide-base-200">

    <!-- Técnico -->
    <div class="p-5">
      <label class="block text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-2">
        Técnico *
      </label>
      <select name="technician"
              class="select select-bordered w-full text-sm {% if errors.technician %}select-error{% endif %}">
        <option value="" disabled {% if not post.technician %}selected{% endif %}>Seleccionar técnico…</option>
        {% for tech in technicians %}
          <option value="{{ tech.pk }}" {% if post.technician == tech.pk|stringformat:"s" %}selected{% endif %}>
            {{ tech.get_full_name|default:tech.email }} — {{ tech.company|upper }} — {{ tech.cargo }}
          </option>
        {% empty %}
          <option disabled>No hay técnicos activos disponibles</option>
        {% endfor %}
      </select>
      {% if errors.technician %}
        <p class="text-error text-xs mt-1">{{ errors.technician }}</p>
      {% endif %}
    </div>

    <!-- Sitio — buscador live -->
    <div class="p-5">
      <label class="block text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-2">
        Sitio *
      </label>
      <input type="hidden" name="site" id="site-id" value="{{ post.site }}">

      <!-- Search input -->
      <div class="relative">
        <div class="flex items-center gap-2 input input-bordered w-full px-3
                    {% if errors.site %}border-error{% endif %}"
             style="height:auto; padding-top:0; padding-bottom:0;">
          <i class="fa-solid fa-magnifying-glass text-base-content/30 text-xs shrink-0"></i>
          <input type="text" id="site-search"
                 placeholder="Escribe al menos 3 caracteres…"
                 autocomplete="off"
                 class="flex-1 bg-transparent outline-none text-sm py-2.5 text-base-content placeholder:text-base-content/30">
          <button type="button" id="site-clear"
                  class="shrink-0 text-base-content/30 hover:text-base-content hidden"
                  title="Limpiar selección">
            <i class="fa-solid fa-xmark text-xs"></i>
          </button>
        </div>

        <!-- Dropdown results -->
        <ul id="site-results"
            class="hidden absolute z-50 w-full mt-1 bg-base-100 border border-base-300 rounded-xl shadow-lg overflow-hidden max-h-56 overflow-y-auto">
        </ul>
      </div>

      {% if errors.site %}
        <p class="text-error text-xs mt-1">{{ errors.site }}</p>
      {% endif %}
    </div>

    <!-- Fecha programada -->
    <div class="p-5">
      <label class="block text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-2">
        Fecha programada *
      </label>
      <input type="date" name="scheduled_date"
             value="{{ post.scheduled_date }}"
             class="input input-bordered w-full text-sm {% if errors.scheduled_date %}input-error{% endif %}">
      {% if errors.scheduled_date %}
        <p class="text-error text-xs mt-1">{{ errors.scheduled_date }}</p>
      {% endif %}
    </div>

    <!-- Objetivo -->
    <div class="p-5">
      <label class="block text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-2">
        Objetivo *
      </label>
      <textarea name="reason" rows="4"
                placeholder="Descripción del trabajo a realizar…"
                class="textarea textarea-bordered w-full text-sm resize-none {% if errors.reason %}textarea-error{% endif %}">{{ post.reason }}</textarea>
      {% if errors.reason %}
        <p class="text-error text-xs mt-1">{{ errors.reason }}</p>
      {% endif %}
    </div>

  </div>

  <!-- Actions -->
  <div class="flex items-center justify-end gap-3 mt-5">
    <a href="{% url 'manager:visits_approval' %}" class="btn btn-ghost btn-sm h-9 min-h-0">Cancelar</a>
    <button type="submit" class="btn btn-primary btn-sm h-9 min-h-0">
      <i class="fa-solid fa-paper-plane text-xs"></i>
      {% if is_edit %}Guardar cambios{% elif request.user.role == 'super_manager' %}Crear y aprobar{% else %}Enviar para aprobación{% endif %}
    </button>
  </div>
</form>

<script>
(function () {
  const searchInput  = document.getElementById('site-search');
  const siteIdInput  = document.getElementById('site-id');
  const resultsList  = document.getElementById('site-results');
  const clearBtn     = document.getElementById('site-clear');
  const searchUrl    = '{% url "manager:sites_search" %}';

  let debounceTimer  = null;
  let selectedSite   = null;

  // Restore selected site (edit mode or validation error)
  {% if initial_site %}
  selectSite({ id: '{{ initial_site.id }}', code: '{{ initial_site.code|escapejs }}', name: '{{ initial_site.name|escapejs }}' });
  {% elif post.site and post.site_name %}
  selectSite({ id: '{{ post.site }}', code: '{{ post.site_code|escapejs }}', name: '{{ post.site_name|escapejs }}' });
  {% endif %}

  searchInput.addEventListener('input', function () {
    const q = this.value.trim();
    clearTimeout(debounceTimer);
    if (selectedSite && this.value !== selectedSite.label) {
      clearSelection(false);
    }
    if (q.length < 3) { hideResults(); return; }
    debounceTimer = setTimeout(() => fetchSites(q), 250);
  });

  searchInput.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') { hideResults(); }
  });

  clearBtn.addEventListener('click', function () {
    clearSelection(true);
  });

  document.addEventListener('click', function (e) {
    if (!e.target.closest('#site-search') && !e.target.closest('#site-results')) {
      hideResults();
    }
  });

  function fetchSites(q) {
    fetch(searchUrl + '?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
      .then(r => {
        if (!r.ok) throw new Error(r.status);
        return r.json();
      })
      .then(sites => renderResults(sites))
      .catch(() => {
        resultsList.innerHTML = '<li class="px-4 py-3 text-sm text-error/70">Error al buscar sitios</li>';
        showResults();
      });
  }

  function renderResults(sites) {
    resultsList.innerHTML = '';
    if (!sites.length) {
      resultsList.innerHTML = '<li class="px-4 py-3 text-sm text-base-content/40">Sin resultados</li>';
      showResults();
      return;
    }
    sites.forEach(site => {
      const li = document.createElement('li');
      li.className = 'flex items-center gap-3 px-4 py-2.5 hover:bg-primary/5 cursor-pointer transition-colors border-b border-base-200 last:border-0';
      li.innerHTML = `
        <span class="inline-flex items-center px-2 py-0.5 rounded bg-primary/10 text-primary font-mono text-xs font-semibold shrink-0">${site.code}</span>
        ${site.operator_code ? `<span class="inline-flex items-center px-1.5 py-0.5 rounded bg-base-200 text-base-content/50 font-mono text-xs shrink-0">${site.operator_code}</span>` : ''}
        <span class="text-sm text-base-content truncate">${site.name}</span>`;
      li.addEventListener('click', () => selectSite(site));
      resultsList.appendChild(li);
    });
    showResults();
  }

  function selectSite(site) {
    selectedSite = { ...site, label: `${site.code} — ${site.name}` };
    siteIdInput.value  = site.id;
    searchInput.value  = selectedSite.label;
    clearBtn.classList.remove('hidden');
    hideResults();
  }

  function clearSelection(focusInput) {
    selectedSite       = null;
    siteIdInput.value  = '';
    searchInput.value  = '';
    clearBtn.classList.add('hidden');
    if (focusInput) searchInput.focus();
  }

  function showResults() { resultsList.classList.remove('hidden'); }
  function hideResults()  { resultsList.classList.add('hidden'); }
})();
</script>

{% endblock %}
</file>

<file path="templates/manager/visits_approval.html">
{% extends "manager/base.html" %}
{% load humanize user_tags %}
{% block title %}Servicios{% endblock %}

{% block content %}

<!-- Tab switcher + Nuevo Servicio -->
<div class="flex items-center justify-between mb-6">
  <div class="flex flex-wrap gap-1 bg-base-200 p-1 rounded-xl w-fit">
    <a href="?tab=planificados"
       class="px-4 py-1.5 rounded-lg text-sm font-semibold transition-all duration-150
              {% if tab == 'planificados' %}bg-base-100 shadow-sm text-base-content{% else %}text-base-content/50 hover:text-base-content{% endif %}">
      Planificados
      {% if pending_count %}<span class="ml-1 badge badge-warning badge-xs font-semibold">{{ pending_count }}</span>{% endif %}
    </a>
    <a href="?tab=programados"
       class="px-4 py-1.5 rounded-lg text-sm font-semibold transition-all duration-150
              {% if tab == 'programados' %}bg-base-100 shadow-sm text-base-content{% else %}text-base-content/50 hover:text-base-content{% endif %}">
      Programados
      {% if programados_count %}<span class="ml-1 badge badge-info badge-xs font-semibold">{{ programados_count }}</span>{% endif %}
    </a>
    <a href="?tab=en_ejecucion"
       class="px-4 py-1.5 rounded-lg text-sm font-semibold transition-all duration-150
              {% if tab == 'en_ejecucion' %}bg-base-100 shadow-sm text-base-content{% else %}text-base-content/50 hover:text-base-content{% endif %}">
      En ejecución
      {% if en_ejecucion_count %}<span class="ml-1 badge badge-warning badge-xs font-semibold">{{ en_ejecucion_count }}</span>{% endif %}
    </a>
    <a href="?tab=concluidos"
       class="px-4 py-1.5 rounded-lg text-sm font-semibold transition-all duration-150
              {% if tab == 'concluidos' %}bg-base-100 shadow-sm text-base-content{% else %}text-base-content/50 hover:text-base-content{% endif %}">
      Concluidos
