            <p class="text-xs text-base-content/90 mt-1">{{ visit.site.name }}</p>
          </td>
          <td class="text-sm text-base-content/70 max-w-xs truncate py-3.5">{{ visit.reason }}</td>
          {% if tab == 'cancelados' %}
          <td class="pt-3.5 pb-6 max-w-xs">
            {% with motivo=visit.notas|default:visit.rejection_reason %}
            {% if motivo %}
            <p class="text-sm text-base-content">{{ motivo }}</p>
            {% else %}
            <span class="text-xs text-base-content/30">—</span>
            {% endif %}
            {% endwith %}
          </td>
          {% endif %}
          <td class="text-sm text-base-content/60 py-3.5 whitespace-nowrap">{{ visit.scheduled_date|date:"d-m-y" }}</td>
          <td class="py-3.5 text-center">
            {% if visit.status == 'completada' %}
            <div class="indicator">
              {% if visit.photos.count %}
              <span class="indicator-item badge badge-xs font-mono font-bold bg-white text-gray-800" style="border-color:rgba(0,0,0,0.35)">{{ visit.photos.count }}</span>
              {% endif %}
              <span class="badge badge-outline badge-success badge-sm font-medium">{{ visit.get_status_display }}</span>
            </div>
            {% else %}
            <div class="inline-flex items-center gap-1">
              <span class="badge badge-outline badge-sm font-medium
                {% if visit.status == 'programada' %}badge-info
                {% elif visit.status == 'en_camino' or visit.status == 'llegada' or visit.status == 'trabajando' %}badge-warning
                {% elif visit.status == 'cancelada' or visit.status == 'rechazada' %}badge-error
                {% else %}badge-ghost{% endif %}">
                {{ visit.get_status_display }}
              </span>
              {% if visit.status == 'en_camino' %}<span class="text-[10px] text-base-content/40 font-mono">2/5</span>
              {% elif visit.status == 'llegada' %}<span class="text-[10px] text-base-content/40 font-mono">3/5</span>
              {% elif visit.status == 'trabajando' %}<span class="text-[10px] text-base-content/40 font-mono">4/5</span>
              {% endif %}
            </div>
            {% endif %}
          </td>
          <td class="py-3.5">
            {% if tab == 'cancelados' %}
              {% if request.user.role == 'super_manager' %}
              <button onclick="document.getElementById('delete-visit-{{ visit.pk }}').showModal()"
