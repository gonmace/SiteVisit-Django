      </button>
      <button type="button" id="map-clear-btn" class="btn btn-ghost btn-sm h-8 min-h-0 px-3 text-xs">
        Limpiar
      </button>
    </form>
  </div>
  <!-- Contador de resultados -->
  <div id="map-summary" class="px-5 py-1.5 border-b border-base-200 bg-base-50 hidden">
    <p id="map-summary-text" class="text-xs text-base-content/50"></p>
  </div>
  <!-- Contenedor del mapa -->
  <div class="relative">
    <div id="operations-map" style="height:460px;"></div>
    <div id="map-loading" class="absolute inset-0 bg-base-100/60 grid place-items-center hidden">
      <span class="loading loading-spinner loading-md text-info"></span>
