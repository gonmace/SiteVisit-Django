              {% else %}
              <div class="w-10 h-10 rounded-full bg-info/10 flex items-center justify-center shrink-0">
                <span class="text-info text-xs font-bold">{{ visit.technician.get_full_name|default:visit.technician.email|initials }}</span>
              </div>
              {% endif %}
              <div class="min-w-0">
                <p class="text-sm font-medium text-base-content truncate">{{ visit.technician.get_full_name|default:"—" }}</p>
                <p class="text-xs text-base-content/50 truncate mt-0.5">{{ visit.technician.email }}</p>
                {% if visit.technician.cargo %}
                <p class="text-xs text-base-content/40 truncate">{{ visit.technician.cargo }}</p>
                {% endif %}
              </div>
            </div>
