<file path="templates/manager/dashboard.html">
{% extends "manager/base.html" %}
{% load humanize %}
{% block title %}Dashboard{% endblock %}

{% block extra_head %}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/MarkerCluster.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css">
{% endblock %}

{% block content %}

<!-- ── Fila 1: KPIs globales ── -->
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3 mb-3">

  <div class="bg-base-100 rounded-2xl border border-base-200 p-4 text-center">
    <p class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Total</p>
    <p class="text-3xl font-black text-base-content mt-1 leading-none">{{ total|intcomma }}</p>
    <p class="text-xs text-base-content/40 mt-1.5">visitas registradas</p>
  </div>

  <div class="bg-base-100 rounded-2xl border border-base-200 p-4 text-center">
    <p class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Activos</p>
    <p class="text-3xl font-black text-edit mt-1 leading-none">{{ active|intcomma }}</p>
    <p class="text-xs text-base-content/40 mt-1.5">en progreso ahora</p>
  </div>

  <div class="bg-base-100 rounded-2xl border border-base-200 p-4 text-center">
    <p class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Completadas</p>
    <p class="text-3xl font-black text-success mt-1 leading-none">{{ by_status.completada|intcomma }}</p>
    <p class="text-xs text-base-content/40 mt-1.5">{{ completion_rate }}% del total</p>
  </div>

  <div class="bg-base-100 rounded-2xl border border-base-200 p-4 text-center">
    <p class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Canceladas</p>
    <p class="text-3xl font-black text-error mt-1 leading-none">{{ by_status.cancelada|intcomma }}</p>
    <p class="text-xs text-base-content/40 mt-1.5">{{ cancellation_rate }}% del total</p>
  </div>

  <div class="col-span-2 md:col-span-1 bg-base-100 rounded-2xl border border-base-200 p-4 text-center">
    <p class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Duración Prom. del Servicio</p>
    {% if avg_duration %}
    <p class="text-3xl font-black text-base-content mt-1 leading-none">{{ avg_duration }}<span class="text-base font-medium ml-0.5">min</span></p>
    {% else %}
    <p class="text-3xl font-black text-base-content/20 mt-1 leading-none">—</p>
    {% endif %}
    <p class="text-xs text-base-content/40 mt-1.5">trabajo completado</p>
  </div>

</div>

<!-- ── Fila 2: KPIs operacionales ── -->
<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 mb-5">

  <div class="bg-base-100 rounded-2xl border border-base-200 p-4 text-center">
    <p class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Hoy</p>
    <p class="text-3xl font-black text-base-content mt-1 leading-none">{{ hoy_count|intcomma }}</p>
    <p class="text-xs text-base-content/40 mt-1.5">visitas programadas</p>
  </div>

  <div class="bg-base-100 rounded-2xl border border-base-200 p-4 text-center">
    <p class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Esta semana</p>
    <p class="text-3xl font-black text-info mt-1 leading-none">{{ semana_count|intcomma }}</p>
    <p class="text-xs text-base-content/40 mt-1.5">últimos 7 días</p>
  </div>

  <div class="bg-base-100 rounded-2xl border border-base-200 p-4 text-center">
    <p class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Pendientes</p>
    <p class="text-3xl font-black {% if pendientes_count %}text-warning{% else %}text-base-content/25{% endif %} mt-1 leading-none">{{ pendientes_count|intcomma }}</p>
    <p class="text-xs text-base-content/40 mt-1.5">por aprobar</p>
  </div>

  <div class="bg-base-100 rounded-2xl border border-base-200 p-4 text-center">
    <p class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Rechazadas</p>
    <p class="text-3xl font-black {% if rechazadas_count %}text-error{% else %}text-base-content/25{% endif %} mt-1 leading-none">{{ rechazadas_count|intcomma }}</p>
    <p class="text-xs text-base-content/40 mt-1.5">{{ rechazo_rate }}% del total</p>
  </div>

  <div class="bg-base-100 rounded-2xl border border-base-200 p-4 text-center">
    <p class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">T. Aprobación</p>
    {% if avg_approval_hours is not None %}
    <p class="text-3xl font-black text-base-content mt-1 leading-none">{{ avg_approval_hours }}<span class="text-base font-medium ml-0.5">h</span></p>
    {% else %}
    <p class="text-3xl font-black text-base-content/20 mt-1 leading-none">—</p>
    {% endif %}
    <p class="text-xs text-base-content/40 mt-1.5">promedio aprobación</p>
  </div>

  <div class="bg-base-100 rounded-2xl border border-base-200 p-4 text-center">
    <p class="text-[10px] font-semibold uppercase tracking-widest text-base-content/40">Completados hoy</p>
    {% if completitud_hoy is not None %}
    <p class="text-3xl font-black text-success mt-1 leading-none">{{ completitud_hoy }}<span class="text-base font-medium ml-0.5">%</span></p>
    <p class="text-xs text-base-content/40 mt-1.5">{{ hoy_completadas }} de {{ hoy_count }}</p>
    {% else %}
    <p class="text-3xl font-black text-base-content/20 mt-1 leading-none">—</p>
    <p class="text-xs text-base-content/40 mt-1.5">sin visitas hoy</p>
    {% endif %}
  </div>

</div>

<!-- ── Distribución de estados ── -->
{% if total %}
<div class="bg-base-100 rounded-2xl border border-base-200 p-5 mb-5">
  <div class="flex items-center gap-2 mb-3.5">
    <div class="w-7 h-7 rounded-lg bg-base-200 flex items-center justify-center">
      <i class="fa-solid fa-chart-bar text-[11px] text-base-content/40"></i>
    </div>
    <p class="text-sm font-bold text-base-content">Distribución por estado</p>
  </div>
  <div class="flex w-full h-2.5 rounded-full overflow-hidden gap-px">
    {% if by_status.programada %}<div style="width:{% widthratio by_status.programada total 100 %}%;background:var(--color-info)" title="Programado: {{ by_status.programada }}"></div>{% endif %}
    {% if active               %}<div style="width:{% widthratio active total 100 %}%;background:var(--color-warning)" title="En ejecución: {{ active }}"></div>{% endif %}
    {% if by_status.completada %}<div style="width:{% widthratio by_status.completada total 100 %}%;background:var(--color-success)" title="Completado: {{ by_status.completada }}"></div>{% endif %}
    {% if by_status.cancelada  %}<div style="width:{% widthratio by_status.cancelada total 100 %}%;background:var(--color-error)" title="Cancelado: {{ by_status.cancelada }}"></div>{% endif %}
  </div>
  <div class="flex flex-wrap gap-x-6 gap-y-1.5 mt-3">
    <span class="flex items-center gap-1.5 text-xs text-base-content/50"><span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:var(--color-info)"></span>Programado <strong class="text-base-content/80 font-semibold ml-0.5">{{ by_status.programada }}</strong></span>
    <span class="flex items-center gap-1.5 text-xs text-base-content/50"><span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:var(--color-warning)"></span>En ejecución <strong class="text-base-content/80 font-semibold ml-0.5">{{ active }}</strong></span>
    <span class="flex items-center gap-1.5 text-xs text-base-content/50"><span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:var(--color-success)"></span>Completado <strong class="text-base-content/80 font-semibold ml-0.5">{{ by_status.completada }}</strong></span>
    <span class="flex items-center gap-1.5 text-xs text-base-content/50"><span class="w-1.5 h-1.5 rounded-full shrink-0" style="background:var(--color-error)"></span>Cancelado <strong class="text-base-content/80 font-semibold ml-0.5">{{ by_status.cancelada }}</strong></span>
  </div>
</div>
{% endif %}

<!-- ── Charts: Tendencia + Doughnut ── -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">

  <div class="lg:col-span-2 bg-base-100 rounded-2xl border border-base-200 p-5">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-primary/10 flex items-center justify-center">
          <i class="fa-solid fa-chart-line text-[11px] text-primary"></i>
        </div>
        <p id="trendTitle" class="text-sm font-bold text-base-content">Últimos 7 días</p>
      </div>
      <div class="flex gap-0.5 bg-base-200 p-0.5 rounded-lg">
        <button onclick="setTrendRange(7, this)"  class="trend-btn px-2.5 py-1 rounded-md text-xs font-semibold bg-base-100 shadow-sm text-base-content transition-all">7d</button>
        <button onclick="setTrendRange(30, this)" class="trend-btn px-2.5 py-1 rounded-md text-xs font-semibold text-base-content/40 hover:text-base-content transition-all">30d</button>
        <button onclick="setTrendRange(90, this)" class="trend-btn px-2.5 py-1 rounded-md text-xs font-semibold text-base-content/40 hover:text-base-content transition-all">90d</button>
      </div>
    </div>
    <div style="height:200px;position:relative;">
      <canvas id="trendChart"></canvas>
    </div>
  </div>

  <div class="bg-base-100 rounded-2xl border border-base-200 p-5">
    <div class="flex items-center gap-2 mb-4">
      <div class="w-7 h-7 rounded-lg bg-base-200 flex items-center justify-center">
        <i class="fa-solid fa-circle-half-stroke text-[11px] text-base-content/40"></i>
      </div>
      <p class="text-sm font-bold text-base-content">Estados</p>
    </div>
    <div style="height:200px;position:relative;">
      <canvas id="statusChart"></canvas>
    </div>
  </div>

</div>

<!-- ── Distribución semanal + Técnicos ── -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-5">

  <div class="lg:col-span-2 bg-base-100 rounded-2xl border border-base-200 p-5">
    <div class="flex items-center gap-2 mb-4">
      <div class="w-7 h-7 rounded-lg bg-base-200 flex items-center justify-center">
        <i class="fa-solid fa-calendar-days text-[11px] text-base-content/40"></i>
      </div>
      <p class="text-sm font-bold text-base-content">Por día de semana</p>
    </div>
    <div style="height:155px;position:relative;">
      <canvas id="weekdayChart"></canvas>
    </div>
  </div>

  <div class="bg-base-100 rounded-2xl border border-base-200 overflow-hidden">
    <!-- Coordinadores -->
    <div class="px-5 py-3.5 border-b border-base-200 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-base-200 flex items-center justify-center">
          <i class="fa-solid fa-user-tie text-[11px] text-base-content/40"></i>
        </div>
        <p class="text-sm font-bold text-base-content">Coordinadores</p>
      </div>
      <span class="text-lg font-black text-base-content tabular-nums">{{ tech_stats.coordinators|intcomma }}</span>
    </div>
    <!-- Técnicos -->
    <div class="px-5 py-3.5 border-b border-base-200 flex items-center justify-between">
      <div class="flex items-center gap-2">
        <div class="w-7 h-7 rounded-lg bg-base-200 flex items-center justify-center">
          <i class="fa-solid fa-users text-[11px] text-base-content/40"></i>
        </div>
        <p class="text-sm font-bold text-base-content">Técnicos</p>
      </div>
      <span class="text-lg font-black text-base-content tabular-nums">{{ tech_stats.total|intcomma }}</span>
    </div>
    <div class="divide-y divide-base-200">
      <div class="flex items-center justify-between px-5 py-3">
        <span class="flex items-center gap-1.5 text-xs text-base-content/40"><span class="w-1.5 h-1.5 rounded-full bg-success shrink-0"></span>Activos</span>
        <span class="text-sm font-bold text-success tabular-nums">{{ tech_stats.active|intcomma }}</span>
      </div>
      <div class="flex items-center justify-between px-5 py-3">
        <span class="flex items-center gap-1.5 text-xs text-base-content/40"><span class="w-1.5 h-1.5 rounded-full bg-warning shrink-0"></span>Pend. Aprobación</span>
        <span class="text-sm font-bold text-warning tabular-nums">{{ tech_stats.pending|intcomma }}</span>
      </div>
      <div class="flex items-center justify-between px-5 py-3">
        <span class="flex items-center gap-1.5 text-xs text-base-content/40"><span class="w-1.5 h-1.5 rounded-full bg-error shrink-0"></span>Inactivos</span>
        <span class="text-sm font-bold text-error tabular-nums">{{ tech_stats.inactive|intcomma }}</span>
      </div>
    </div>
  </div>

</div>

<!-- ── Mapa de operaciones ── -->
<div class="bg-base-100 rounded-2xl border border-base-200 overflow-hidden mb-5">
  <div class="px-5 py-3.5 border-b border-base-200 flex items-center justify-between flex-wrap gap-2">
    <div class="flex items-center gap-3">
      <div class="flex items-center gap-2">
