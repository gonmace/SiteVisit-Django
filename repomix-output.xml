<div class="mb-5">
  <a href="{% url 'manager:sites_list' %}"
     class="inline-flex items-center gap-1.5 text-sm text-base-content/50 hover:text-primary transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
    </svg>
    Volver a sitios
  </a>
</div>

<div class="max-w-lg">
  <div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs overflow-hidden">

    <!-- Header -->
    <div class="px-5 py-4 border-b border-base-200 flex items-center justify-between">
      <div>
        <p class="text-xs font-semibold text-base-content/40 uppercase tracking-wide">Sitio</p>
        <h2 class="text-lg font-bold text-base-content tracking-tight font-mono">{{ site.code }}</h2>
      </div>
      <span class="inline-flex items-center px-2.5 py-1 rounded-lg bg-base-200 text-base-content/70 text-xs font-semibold uppercase tracking-wide">
        {{ site.get_company_display }}
      </span>
    </div>

    <!-- Fields -->
    <div class="divide-y divide-base-200">
      <div class="flex items-start gap-3 px-5 py-3">
        <span class="text-xs font-medium text-base-content/40 w-32 shrink-0 pt-0.5">Nombre</span>
        <span class="text-sm text-base-content">{{ site.name }}</span>
      </div>
      <div class="flex items-start gap-3 px-5 py-3">
        <span class="text-xs font-medium text-base-content/40 w-32 shrink-0 pt-0.5">Cód. Operador</span>
        <span class="text-sm font-mono text-base-content/70">{{ site.operator_code|default:"—" }}</span>
      </div>
      <div class="flex items-start gap-3 px-5 py-3">
        <span class="text-xs font-medium text-base-content/40 w-32 shrink-0 pt-0.5">Latitud</span>
        <span class="text-sm font-mono text-base-content/70">{{ site.latitude|stringformat:".6f" }}</span>
      </div>
      <div class="flex items-start gap-3 px-5 py-3">
        <span class="text-xs font-medium text-base-content/40 w-32 shrink-0 pt-0.5">Longitud</span>
        <span class="text-sm font-mono text-base-content/70">{{ site.longitude|stringformat:".6f" }}</span>
      </div>
      <div class="flex items-start gap-3 px-5 py-3">
        <span class="text-xs font-medium text-base-content/40 w-32 shrink-0 pt-0.5">Altura (m)</span>
        <span class="text-sm font-mono text-base-content/70">
          {% if site.height is not None %}{{ site.height|intcomma }}{% else %}—{% endif %}
        </span>
      </div>
      <div class="flex items-start gap-3 px-5 py-3">
        <span class="text-xs font-medium text-base-content/40 w-32 shrink-0 pt-0.5">Estado</span>
        {% if site.is_active %}
          <span class="badge badge-sm badge-success">Activo</span>
        {% else %}
          <span class="badge badge-sm badge-error">Inactivo</span>
        {% endif %}
      </div>
    </div>

    <!-- Actions -->
    {% if is_manager %}
    <div class="px-5 py-4 border-t border-base-200 flex gap-2 justify-end">
      <a href="{% url 'manager:site_edit' site.pk %}" class="btn btn-edit btn-sm h-9 min-h-0 text-xs font-semibold">
        <i class="fa-solid fa-pen mr-1"></i> Editar
      </a>
      <a href="{% url 'manager:site_delete' site.pk %}" class="btn btn-delete btn-sm h-9 min-h-0 text-xs font-semibold">
        <i class="fa-solid fa-trash-can mr-1"></i> Eliminar
      </a>
    </div>
    {% endif %}

  </div>
</div>

{% endblock %}
</file>

<file path="templates/manager/site_form.html">
{% extends "manager/base.html" %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<div class="max-w-2xl mx-auto">

  <div class="flex items-center gap-3 mb-6">
    <a href="{{ cancel_url }}" class="btn btn-ghost btn-sm h-9 min-h-0 border border-base-300 text-base-content/50 text-xs">
      ← Volver
    </a>
    <h1 class="text-xl font-bold text-base-content tracking-tight">{{ title }}</h1>
  </div>

  <div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs p-6">
    <form method="post" novalidate>
      {% csrf_token %}

      {% if form.non_field_errors %}
        <div class="alert alert-error text-sm mb-4">{{ form.non_field_errors }}</div>
      {% endif %}

      <div class="grid grid-cols-2 gap-4">

        <!-- Código Sitio -->
        <div class="form-control">
          <label class="label py-1">
            <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">{{ form.code.label }}</span>
          </label>
          {{ form.code }}
          {% if form.code.errors %}<p class="text-xs text-error mt-1">{{ form.code.errors.0 }}</p>{% endif %}
        </div>

        <!-- Código Operador -->
        <div class="form-control">
          <label class="label py-1">
            <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">{{ form.operator_code.label }}</span>
          </label>
          {{ form.operator_code }}
          {% if form.operator_code.errors %}<p class="text-xs text-error mt-1">{{ form.operator_code.errors.0 }}</p>{% endif %}
        </div>

        <!-- Nombre Sitio (full width) -->
        <div class="form-control col-span-2">
          <label class="label py-1">
            <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">{{ form.name.label }}</span>
          </label>
          {{ form.name }}
          {% if form.name.errors %}<p class="text-xs text-error mt-1">{{ form.name.errors.0 }}</p>{% endif %}
        </div>

        <!-- Latitud -->
        <div class="form-control">
          <label class="label py-1">
            <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">{{ form.latitude.label }}</span>
          </label>
          {{ form.latitude }}
          {% if form.latitude.errors %}<p class="text-xs text-error mt-1">{{ form.latitude.errors.0 }}</p>{% endif %}
        </div>

        <!-- Longitud -->
        <div class="form-control">
          <label class="label py-1">
            <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">{{ form.longitude.label }}</span>
          </label>
          {{ form.longitude }}
          {% if form.longitude.errors %}<p class="text-xs text-error mt-1">{{ form.longitude.errors.0 }}</p>{% endif %}
        </div>

        <!-- Altura -->
        <div class="form-control">
          <label class="label py-1">
            <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">{{ form.height.label }} <span class="text-base-content/30 normal-case font-normal">(opcional)</span></span>
          </label>
          {{ form.height }}
          {% if form.height.errors %}<p class="text-xs text-error mt-1">{{ form.height.errors.0 }}</p>{% endif %}
        </div>

        <!-- Empresa -->
        <div class="form-control">
          <label class="label py-1">
            <span class="label-text text-xs font-semibold text-base-content/70 uppercase tracking-wide">{{ form.company.label }}</span>
          </label>
          {{ form.company }}
          {% if form.company.errors %}<p class="text-xs text-error mt-1">{{ form.company.errors.0 }}</p>{% endif %}
        </div>

        <!-- Activo -->
        <div class="form-control col-span-2">
          <label class="label cursor-pointer justify-start gap-3 py-1">
            {{ form.is_active }}
            <span class="label-text text-sm font-medium">{{ form.is_active.label }}</span>
          </label>
        </div>

      </div>

      <div class="flex justify-end gap-2 mt-6 pt-4 border-t border-base-200">
        <a href="{{ cancel_url }}" class="btn btn-ghost btn-sm h-9 min-h-0 text-xs">Cancelar</a>
        <button type="submit" class="btn btn-primary btn-sm h-9 min-h-0 px-5 text-xs font-semibold">Guardar</button>
      </div>
    </form>
  </div>

</div>
{% endblock %}
</file>

<file path="templates/manager/site_import.html">
{% extends "manager/base.html" %}
{% block title %}Importar Sitios{% endblock %}

{% block content %}
<div class="max-w-xl mx-auto">

  <!-- Back + title -->
  <div class="flex items-center gap-3 mb-6">
    <a href="{% url 'manager:sites_list' %}"
       class="btn btn-ghost btn-sm h-9 min-h-0 border border-base-300 text-base-content/50 text-xs">
      ← Volver
    </a>
    <div>
      <h1 class="text-xl font-bold text-base-content tracking-tight">Importar Sitios</h1>
      <p class="text-xs text-base-content/40 mt-0.5">Carga masiva desde archivo Excel</p>
    </div>
  </div>

  <!-- Upload card -->
  <div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs overflow-hidden mb-4">

    <form method="post" enctype="multipart/form-data" id="import-form" class="p-6">
      {% csrf_token %}

      <!-- DaisyUI file input -->
      <fieldset class="fieldset">
        <legend class="fieldset-legend text-sm font-semibold">Seleccionar archivo</legend>
        <input id="file-input" type="file" name="file"
               accept=".xlsx,.xls"
                class="file-input w-full"
               onchange="document.getElementById('file-name').textContent = this.files[0]?.name || ''">
        <span class="fieldset-label text-xs text-base-content/40">
          Formatos permitidos: .xlsx, .xls — Fila 1 = encabezado. Si el código ya existe, actualiza los datos.
        </span>
      </fieldset>

      <!-- File name feedback + actions -->
      <div class="flex items-center justify-between mt-4 pt-4 border-t border-base-200">
        <span id="file-name" class="text-xs text-base-content/50 truncate italic"></span>
        <div class="flex gap-2 shrink-0 ml-4">
          <a href="{% url 'manager:sites_list' %}"
             class="btn btn-ghost btn-xs h-7 min-h-0 text-xs text-base-content/40">Cancelar</a>
          <button type="submit"
                  class="btn btn-secondary btn-sm text-xs font-semibold">
            Importar
          </button>
        </div>
      </div>
    </form>

    <!-- Column format reference -->
    <div class="px-6 py-5">
      <p class="text-xs font-semibold text-base-content/40 uppercase tracking-wide mb-3">
        Formato de columnas
      </p>
      <div class="flex flex-wrap gap-2">

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">A</span>
          <span class="text-xs font-medium text-base-content">Código Sitio</span>
          <span class="text-error text-xs leading-none">*</span>
        </div>

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">B</span>
          <span class="text-xs text-base-content/60">Cód. Operador</span>
        </div>

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">C</span>
          <span class="text-xs font-medium text-base-content">Nombre Sitio</span>
          <span class="text-error text-xs leading-none">*</span>
        </div>

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">D</span>
          <span class="text-xs font-medium text-base-content">Latitud</span>
          <span class="text-error text-xs leading-none">*</span>
        </div>

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">E</span>
          <span class="text-xs font-medium text-base-content">Longitud</span>
          <span class="text-error text-xs leading-none">*</span>
        </div>

        <div class="flex items-center gap-1.5 bg-base-200/70 rounded-lg px-3 py-1.5">
          <span class="text-[10px] font-bold text-base-content/30 font-mono">F</span>
          <span class="text-xs text-base-content/60">Altura (m)</span>
        </div>

      </div>
      <p class="text-xs text-base-content/30 mt-3">
        <span class="text-error">*</span> Requeridos. Fila 1 = encabezado. Si el código ya existe, actualiza los datos.
      </p>
    </div>

  </div>

</div>
{% endblock %}
</file>

<file path="templates/manager/sites_list.html">
{% extends "manager/base.html" %}
{% load humanize %}
{% block title %}Sitios{% endblock %}

{% block content %}

<!-- Header + search -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <h1 class="text-xl font-bold text-base-content tracking-tight">Sitios</h1>
    <p class="text-xs text-base-content/40 mt-0.5">{{ page_obj.paginator.count|intcomma }} sitio(s)</p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <form method="get" class="flex items-center gap-2">
      <input type="search" name="q" value="{{ q }}"
             placeholder="Código o nombre…"
             class="input input-bordered input-sm h-9 w-48 text-sm">
      <button type="submit" class="btn btn-info btn-sm h-9 min-h-0 px-4 text-xs font-semibold">
        Buscar
      </button>
      {% if q %}
        <a href="{% url 'manager:sites_list' %}" class="btn btn-ghost btn-sm h-9 min-h-0 text-xs text-base-content/50">
          Limpiar
        </a>
      {% endif %}
    </form>
    {% if is_manager %}
      <a href="{% url 'manager:site_import' %}" class="btn btn-secondary btn-sm h-9 min-h-0 text-xs">
        Importar Excel
      </a>
      <a href="{% url 'manager:site_create' %}" class="btn btn-success btn-sm h-9 min-h-0 px-4 text-xs font-semibold">
        + Agregar
      </a>
    {% endif %}
  </div>
</div>

{% if sites %}
<div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs overflow-hidden">
  <div class="overflow-x-auto">
    <table class="table table-sm">
      <thead>
        <tr>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Cód. Sitio</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Cód. Operador</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Nombre Sitio</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Empresa</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide text-right">Alt. (m)</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide text-right">Latitud</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide text-right">Longitud</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide text-right">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {% for site in sites %}
        <tr class="hover:bg-primary/5 transition-colors">
          <td class="py-3.5">
            <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-primary/10 text-primary font-mono text-xs font-medium">
              {{ site.code }}
            </span>
          </td>
          <td class="py-3.5">
            <span class="font-mono text-sm text-base-content/60">{{ site.operator_code|default:"—" }}</span>
          </td>
          <td class="py-3.5">
            <span class="text-sm font-medium text-base-content">{{ site.name }}</span>
          </td>
          <td class="py-3.5">
            <span class="inline-flex items-center px-2 py-0.5 rounded-md bg-base-200 text-base-content/70 text-xs font-semibold uppercase tracking-wide">
              {{ site.get_company_display }}
            </span>
          </td>
          <td class="py-3.5 text-right">
            <span class="font-mono text-sm text-base-content/60">
              {% if site.height is not None %}{{ site.height|intcomma }}{% else %}<span class="text-base-content/30">—</span>{% endif %}
            </span>
          </td>
          <td class="py-3.5 text-right">
            <span class="font-mono text-xs text-base-content/60">{{ site.latitude|stringformat:".6f" }}</span>
          </td>
          <td class="py-3.5 text-right">
            <span class="font-mono text-xs text-base-content/60">{{ site.longitude|stringformat:".6f" }}</span>
          </td>
          <td class="py-3.5 text-right whitespace-nowrap">
            <a href="{% url 'manager:site_detail' site.pk %}"
               class="inline-flex items-center justify-center w-7 h-7 text-view hover:opacity-70 transition-opacity" title="Ver">
              <i class="fa-solid fa-eye"></i>
            </a>
            {% if is_manager %}
            <a href="{% url 'manager:site_edit' site.pk %}"
               class="inline-flex items-center justify-center w-7 h-7 text-edit hover:opacity-70 transition-opacity" title="Editar">
              <i class="fa-solid fa-pen"></i>
            </a>
            <a href="{% url 'manager:site_delete' site.pk %}"
               class="inline-flex items-center justify-center w-7 h-7 text-delete hover:opacity-70 transition-opacity" title="Eliminar">
              <i class="fa-solid fa-trash-can"></i>
            </a>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% if page_obj.has_other_pages %}
<div class="flex justify-center items-center mt-6 gap-2">
  {% if page_obj.has_previous %}
    <a href="?q={{ q }}&page={{ page_obj.previous_page_number }}"
       class="btn btn-ghost btn-sm border border-base-300 text-secondary/60 h-9 min-h-0">‹</a>
  {% endif %}
  <span class="text-sm text-base-content/50 px-3">
    {{ page_obj.number }} / {{ page_obj.paginator.num_pages }}
  </span>
  {% if page_obj.has_next %}
    <a href="?q={{ q }}&page={{ page_obj.next_page_number }}"
       class="btn btn-ghost btn-sm border border-base-300 text-secondary/60 h-9 min-h-0">›</a>
  {% endif %}
</div>
{% endif %}

{% else %}
<div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs">
  <div class="flex flex-col items-center justify-center py-20 px-8 text-center">
    <div class="w-12 h-12 rounded-2xl bg-base-200 flex items-center justify-center mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
      </svg>
    </div>
    <p class="text-sm font-medium text-base-content/40">
      {% if q %}No se encontraron sitios para "{{ q }}"{% else %}Sin sitios registrados{% endif %}
    </p>
    {% if is_manager and not q %}
      <a href="{% url 'manager:site_create' %}" class="btn btn-success btn-sm mt-4 text-xs font-semibold">+ Agregar sitio</a>
    {% endif %}
  </div>
</div>
{% endif %}

{% endblock %}
</file>

<file path="templates/manager/technician_confirm_delete.html">
{% extends "manager/base.html" %}
{% block title %}Eliminar Técnico{% endblock %}

{% block content %}
<div class="max-w-md mx-auto mt-8">
