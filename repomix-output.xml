                <button type="submit" class="btn btn-success btn-xs h-7 min-h-0 px-2.5 font-medium">
                  Aprobar
                </button>
              </form>
              <button onclick="document.getElementById('reject-visit-{{ visit.pk }}').showModal()"
                      class="btn btn-ghost btn-xs h-7 min-h-0 px-2.5 text-error hover:bg-error/8">
                Rechazar
              </button>
              {% else %}
              <a href="{% url 'manager:visit_edit' pk=visit.pk %}"
                 class="btn btn-edit btn-xs h-7 min-h-0 px-2.5 font-medium">
                <i class="fa-solid fa-pen text-xs"></i>
                Editar
              </a>
              <button onclick="document.getElementById('cancel-visit-{{ visit.pk }}').showModal()"
                      class="btn btn-ghost btn-xs h-7 min-h-0 px-2.5 text-error hover:bg-error/8">
                Cancelar
              </button>
              {% endif %}
            </div>
          </td>

        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

{% else %}
<!-- ── Programados / En ejecución / Concluidos / Cancelados table ── -->
<div class="bg-base-100 rounded-2xl shadow-xs border border-base-300 overflow-hidden">
  <div class="overflow-x-auto">
    <table class="table table-sm">
      <thead>
        <tr>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide w-60">Técnico</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide w-72">Sitio</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide w-72">Objetivo</th>
          {% if tab == 'cancelados' %}<th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide w-72">Motivo</th>{% endif %}
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Fecha</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Estado</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Acciones</th>
        </tr>
