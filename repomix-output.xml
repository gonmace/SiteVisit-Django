              {% else %}
              <div class="w-8 h-8 rounded-full bg-info/10 flex items-center justify-center shrink-0">
                <span class="text-info text-xs font-bold">{{ visit.technician.get_full_name|default:visit.technician.email|initials }}</span>
              </div>
              {% endif %}
              <div class="min-w-0">
                <p class="text-sm font-medium text-base-content truncate">{{ visit.technician.get_full_name|default:"—" }}</p>
                <p class="text-xs text-base-content/40 truncate mt-0.5">{{ visit.technician.email }}</p>
              </div>
            </div>
          </td>

          <!-- Sitio -->
          <td class="py-3.5">
            <div class="flex items-center gap-3">
              <span class="text-primary font-mono text-xs font-semibold">{{ visit.site.code }}</span>
              {% if visit.site.operator_code %}
              <span class="text-info font-mono text-xs">{{ visit.site.operator_code }}</span>
              {% endif %}
            </div>
            <p class="text-xs text-base-content/90 mt-1">{{ visit.site.name }}</p>
          </td>

          <!-- Objetivo -->
          <td class="text-sm text-base-content/70 max-w-xs truncate py-3.5">{{ visit.reason }}</td>

          <!-- Fecha / ETA -->
