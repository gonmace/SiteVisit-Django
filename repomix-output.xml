      </button>
    </div>
    <!-- Filtros -->
    <form id="map-filter-form" class="flex flex-wrap items-center gap-2">
      {% if is_super_manager %}
      <select name="company" class="select select-bordered select-sm h-8 min-h-0 text-xs w-28">
        <option value="all">Todas las empresas</option>
        <option value="wom">WOM</option>
        <option value="pti">PTI</option>
      </select>
      {% endif %}
      <select name="status" class="select select-bordered select-sm h-8 min-h-0 text-xs w-36">
        <option value="">Todos los estados</option>
        <option value="pendiente_aprobacion">Planificados</option>
        <option value="programada">Programados</option>
        <option value="en_camino,llegada,trabajando,finalizando">En Ejecución</option>
        <option value="completada">Concluidos</option>
        <option value="cancelada,rechazada">Cancelados</option>
      </select>
      {% if available_technicians %}
      <select name="technician" class="select select-bordered select-sm h-8 min-h-0 text-xs w-40">
        <option value="">Todos los técnicos</option>
        {% for tech in available_technicians %}
        <option value="{{ tech.id }}">{{ tech.first_name }} {{ tech.last_name }}</option>
        {% endfor %}
      </select>
      {% endif %}
      <input type="date" name="date_from" value="{{ map_date_from }}"
             class="input input-bordered input-sm h-8 min-h-0 text-xs w-32">
      <input type="date" name="date_to" value="{{ map_date_to }}"
             class="input input-bordered input-sm h-8 min-h-0 text-xs w-32">
      <button type="submit" class="btn btn-info btn-sm h-8 min-h-0 px-3">
        <i class="fa-solid fa-magnifying-glass text-xs"></i>
