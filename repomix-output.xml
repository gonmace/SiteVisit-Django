<!-- Pagination -->
{% if page_obj.has_other_pages %}
<div class="flex justify-center items-center mt-6 gap-2">
  {% if page_obj.has_previous %}
    <a href="?tab={{ tab }}&page={{ page_obj.previous_page_number }}"
       class="btn btn-ghost btn-sm border border-base-300 text-secondary/60 h-9 min-h-0">‹</a>
  {% endif %}
  <span class="text-sm text-base-content/50 px-3">
    {{ page_obj.number }} / {{ page_obj.paginator.num_pages }}
  </span>
  {% if page_obj.has_next %}
    <a href="?tab={{ tab }}&page={{ page_obj.next_page_number }}"
       class="btn btn-ghost btn-sm border border-base-300 text-secondary/60 h-9 min-h-0">›</a>
  {% endif %}
</div>
{% endif %}

{% else %}
<!-- Empty state -->
<div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs">
  <div class="flex flex-col items-center justify-center py-20 px-8 text-center">
    <div class="w-12 h-12 rounded-2xl bg-base-200 flex items-center justify-center mb-4">
      {% if tab == 'planificados' %}
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      {% else %}
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-base-content/30" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
      </svg>
      {% endif %}
    </div>
    <p class="text-sm font-medium text-base-content/40">
      {% if tab == 'planificados' %}Sin servicios pendientes de aprobación
      {% elif tab == 'programados' %}Sin servicios programados
      {% elif tab == 'en_ejecucion' %}Sin servicios en ejecución
      {% elif tab == 'concluidos' %}Sin servicios concluidos
      {% else %}Sin servicios cancelados
      {% endif %}
    </p>
    {% if tab == 'planificados' %}
    <p class="text-xs text-base-content/30 mt-1">Todos los servicios han sido procesados</p>
    {% endif %}
  </div>
</div>
{% endif %}

<!-- Cancel modals (solo coordinador, tab planificados) -->
{% if tab == 'planificados' and request.user.role != 'super_manager' %}
{% for visit in visits %}
<dialog id="cancel-visit-{{ visit.pk }}" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box shadow-xl">
    <h3 class="font-bold text-base text-base-content">Cancelar servicio</h3>
    <p class="text-sm text-base-content/50 mt-1 mb-4">
      Servicio para <strong class="text-base-content">{{ visit.technician.get_full_name }}</strong>
      en <strong class="text-base-content">{{ visit.site.code }}</strong>
      — {{ visit.scheduled_date|date:"d/m/Y" }}.
    </p>
    <form method="post" action="{% url 'manager:visit_cancel' pk=visit.pk %}">
      {% csrf_token %}
      <div class="mb-4">
        <label class="block text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-2">
          Motivo de cancelación *
        </label>
        <textarea name="cancellation_reason"
                  required
                  minlength="3"
                  rows="3"
                  placeholder="Indica el motivo por el que se cancela este servicio…"
                  class="textarea textarea-bordered w-full text-sm resize-none"></textarea>
      </div>
      <div class="modal-action">
        <button type="button" onclick="this.closest('dialog').close()"
                class="btn btn-ghost btn-sm text-base-content/50">Volver</button>
        <button type="submit" class="btn btn-delete btn-sm">Cancelar servicio</button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
{% endfor %}
{% endif %}

<!-- Reject modals (solo para tab planificados) -->
{% if tab == 'planificados' %}
{% for visit in visits %}
<dialog id="reject-visit-{{ visit.pk }}" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box shadow-xl">
    <h3 class="font-bold text-base text-base-content">Rechazar servicio</h3>
    <p class="text-sm text-base-content/50 mt-1 mb-4">
      Servicio para <strong class="text-base-content">{{ visit.technician.get_full_name }}</strong>
      en <strong class="text-base-content">{{ visit.site.code }}</strong>
      — {{ visit.scheduled_date|date:"d/m/Y" }}.
    </p>
    <form method="post" action="{% url 'manager:visit_reject' pk=visit.pk %}">
      {% csrf_token %}
      <div class="mb-4">
        <label class="block text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-2">
          Motivo de rechazo *
        </label>
        <textarea name="rejection_reason"
                  required
                  minlength="3"
                  rows="3"
                  placeholder="Indica el motivo por el que se rechaza este servicio…"
                  class="textarea textarea-bordered w-full text-sm resize-none"></textarea>
      </div>
      <div class="modal-action">
        <button type="button" onclick="this.closest('dialog').close()"
                class="btn btn-ghost btn-sm text-base-content/50">Cancelar</button>
        <button type="submit" class="btn btn-delete btn-sm">Rechazar servicio</button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
{% endfor %}
{% endif %}

<!-- Delete modals (solo super_manager, tab cancelados) -->
{% if tab == 'cancelados' and request.user.role == 'super_manager' %}
{% for visit in visits %}
<dialog id="delete-visit-{{ visit.pk }}" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box shadow-xl">
    <h3 class="font-bold text-base text-base-content">Eliminar servicio</h3>
    <p class="text-sm text-base-content/50 mt-1 mb-4">
      Esta acción es <strong class="text-error">irreversible</strong>. Se eliminará permanentemente el servicio de
      <strong class="text-base-content">{{ visit.technician.get_full_name }}</strong>
      en <strong class="text-base-content">{{ visit.site.code }}</strong>
      — {{ visit.scheduled_date|date:"d/m/Y" }}.
    </p>
    <form method="post" action="{% url 'manager:visit_delete' pk=visit.pk %}">
      {% csrf_token %}
      <div class="modal-action">
        <button type="button" onclick="this.closest('dialog').close()"
                class="btn btn-ghost btn-sm text-base-content/50">Cancelar</button>
        <button type="submit" class="btn btn-delete btn-sm">
          <i class="fa-solid fa-trash text-xs"></i>
          Eliminar servicio
        </button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
{% endfor %}
{% endif %}

{% endblock %}
