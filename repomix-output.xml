{% block extra_scripts %}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
(function () {
  'use strict';

  var isDark      = document.documentElement.getAttribute('data-theme') === 'dark';
  var gridColor   = isDark ? 'rgba(255,255,255,0.05)' : 'rgba(0,0,0,0.05)';
  var labelColor  = isDark ? 'rgba(242,242,247,0.35)' : 'rgba(28,28,30,0.35)';
  var cs          = getComputedStyle(document.documentElement);
  var primaryColor  = cs.getPropertyValue('--color-primary').trim()  || '#E6007E';
  var infoColor     = cs.getPropertyValue('--color-info').trim()     || '#3B82F6';
  var warningColor  = cs.getPropertyValue('--color-warning').trim()  || '#F59E0B';
  var successColor  = cs.getPropertyValue('--color-success').trim()  || '#10B981';
  var errorColor    = cs.getPropertyValue('--color-error').trim()    || '#EF4444';

  // Gradient para el área del trend
  function makeGradient(ctx, color) {
    var gradient = ctx.createLinearGradient(0, 0, 0, 200);
    gradient.addColorStop(0, color + '28');
    gradient.addColorStop(1, color + '00');
    return gradient;
  }

  var trendCanvas = document.getElementById('trendChart');
  var trendCtx    = trendCanvas.getContext('2d');
  var trendRanges = JSON.parse('{{ trend_ranges_json|escapejs }}');
  var rangeTitles = { '7': 'Últimos 7 días', '30': 'Últimos 30 días', '90': 'Últimas 13 semanas' };

  var trendChart = new Chart(trendCtx, {
    type: 'line',
    data: {
      labels: JSON.parse('{{ trend_labels_json|escapejs }}'),
      datasets: [{
        label: 'Visitas',
        data: JSON.parse('{{ trend_data_json|escapejs }}'),
        borderColor: primaryColor,
        backgroundColor: makeGradient(trendCtx, primaryColor),
        fill: true,
        tension: 0.4,
        pointRadius: 3,
        pointHoverRadius: 5,
        pointBackgroundColor: primaryColor,
        pointBorderColor: 'transparent',
        borderWidth: 2,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false, padding: 10 } },
      scales: {
        x: { grid: { color: gridColor }, border: { display: false }, ticks: { color: labelColor, font: { size: 11 }, maxRotation: 0 } },
        y: { grid: { color: gridColor }, border: { display: false }, ticks: { color: labelColor, font: { size: 11 }, stepSize: 1, precision: 0 }, beginAtZero: true }
      }
    }
  });

  window.setTrendRange = function (days, btn) {
    var key   = String(days);
    var range = trendRanges[key];
    trendChart.data.labels = range.labels;
    trendChart.data.datasets[0].data = range.data;
    trendChart.data.datasets[0].backgroundColor = makeGradient(trendCtx, primaryColor);
    trendChart.update();
    document.getElementById('trendTitle').textContent = rangeTitles[key];
    document.querySelectorAll('.trend-btn').forEach(function (b) {
      b.classList.remove('bg-base-100', 'shadow-sm', 'text-base-content');
      b.classList.add('text-base-content/40');
    });
    btn.classList.add('bg-base-100', 'shadow-sm', 'text-base-content');
    btn.classList.remove('text-base-content/40');
  };

  // Barras — día de semana (0=Lun … 4=Vie · 5=Sáb · 6=Dom)
  var weekdayBg     = [0,1,2,3,4,5,6].map(function(i){ return (i>=5 ? primaryColor : infoColor) + '28'; });
  var weekdayBorder = [0,1,2,3,4,5,6].map(function(i){ return (i>=5 ? primaryColor : infoColor) + '90'; });

  new Chart(document.getElementById('weekdayChart'), {
    type: 'bar',
    data: {
      labels: JSON.parse('{{ weekday_labels_json|escapejs }}'),
      datasets: [{
        label: 'Visitas',
        data: JSON.parse('{{ weekday_data_json|escapejs }}'),
        backgroundColor: weekdayBg,
        borderColor: weekdayBorder,
        borderWidth: 1.5,
        borderRadius: 8,
        borderSkipped: false,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false, padding: 10 } },
      scales: {
        x: { grid: { display: false }, border: { display: false }, ticks: { color: labelColor, font: { size: 11 } } },
        y: { grid: { color: gridColor }, border: { display: false }, ticks: { color: labelColor, font: { size: 11 }, stepSize: 1, precision: 0 }, beginAtZero: true }
      }
    }
  });

  // Doughnut — estados
  new Chart(document.getElementById('statusChart'), {
    type: 'doughnut',
    data: {
      labels: ['Programado', 'En ejecución', 'Completado', 'Cancelado'],
      datasets: [{
        data: [{{ by_status.programada }}, {{ active }}, {{ by_status.completada }}, {{ by_status.cancelada }}],
        backgroundColor: [infoColor, warningColor, successColor, errorColor],
        borderWidth: 0,
        hoverOffset: 6,
      }]
    },
    options: {
      responsive: true,
      maintainAspectRatio: false,
      cutout: '72%',
      plugins: {
        legend: {
          display: true,
          position: 'bottom',
          labels: {
            color: labelColor,
            font: { size: 10 },
            boxWidth: 8,
            boxHeight: 8,
            padding: 10,
            usePointStyle: true,
            pointStyle: 'circle',
            filter: function (item, data) { return data.datasets[0].data[item.index] > 0; }
          }
        },
        tooltip: { padding: 10 }
      }
    }
  });
})();
</script>

<!-- ── Mapa de operaciones con Leaflet ── -->
<script src="https://cdn.jsdelivr.net/npm/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
<script>
(function () {
  'use strict';

  var cs = getComputedStyle(document.documentElement);
  function cssVar(n) { return cs.getPropertyValue(n).trim(); }

  var infoColor    = cssVar('--color-info')    || '#3B82F6';
  var warningColor = cssVar('--color-warning') || '#F59E0B';
  var successColor = cssVar('--color-success') || '#10B981';
  var errorColor   = cssVar('--color-error')   || '#EF4444';
  var WOM_COLOR    = '#E6007E';
  var PTI_COLOR    = infoColor;

  // Color por estado de visita
  var STATUS_COLORS = {
    pendiente_aprobacion: warningColor,
    programada:           infoColor,
    en_camino:            '#F97316',
    llegada:              warningColor,
    trabajando:           '#8B5CF6',
    finalizando:          '#14B8A6',
    completada:           successColor,
    cancelada:            errorColor,
    rechazada:            '#9CA3AF',
  };

  // Toggle: mostrar todos los sitios del catálogo
  var showAllSites = false;

  var map = L.map('operations-map', { zoomControl: true });
  L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap',
    maxZoom: 19,
  }).addTo(map);
  map.setView([-33.45, -70.65], 6);

  // Capa 1: una visita = un marcador, con color por estado
  var clusterGroup = L.markerClusterGroup({ chunkedLoading: true });
  map.addLayer(clusterGroup);

  // Capa 2: globos balloon para todos los sitios del catálogo (toggle)
  var allSitesGroup = L.layerGroup();
  map.addLayer(allSitesGroup);

  // ── Iconos ──

  function visitIcon(status) {
    var color = STATUS_COLORS[status] || '#6B7280';
    var html = '<div style="width:30px;height:30px;border-radius:50%;background:' + color
      + ';border:2.5px solid white;box-shadow:0 2px 8px rgba(0,0,0,0.28);'
      + 'display:flex;align-items:center;justify-content:center;">'
      + '<i class="fa-solid fa-person-digging" style="color:white;font-size:11px;"></i>'
      + '</div>';
    return L.divIcon({
      className: '',
      iconSize: [30, 30],
      iconAnchor: [15, 15],
      popupAnchor: [0, -18],
      html: html,
    });
  }

  function ghostSiteIcon(company) {
    var color = company === 'wom' ? WOM_COLOR : PTI_COLOR;
    var svg = '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="32" viewBox="0 0 26 38"'
            + ' style="opacity:0.75;filter:drop-shadow(0 1px 3px rgba(0,0,0,0.25));">'
            + '<path d="M13 0C5.82 0 0 5.82 0 13C0 22.75 13 38 13 38S26 22.75 26 13C26 5.82 20.18 0 13 0Z" fill="' + color + '"/>'
            + '<circle cx="13" cy="12" r="6.5" fill="rgba(255,255,255,0.88)"/>'
            + '</svg>';
    return L.divIcon({
      className: '',
      iconSize: [22, 32],
      iconAnchor: [11, 32],
      popupAnchor: [0, -34],
      html: svg,
    });
  }

  // ── Popups ──

  function buildVisitPopup(v) {
    var color = STATUS_COLORS[v.status] || '#6B7280';
    return '<div style="min-width:190px;">'
      + '<p style="font-size:12px;font-weight:700;color:' + color + ';margin:0 0 5px;">' + v.status_display + '</p>'
      + '<p style="font-size:13px;font-weight:700;margin:0 0 1px;">' + v.site_code + '</p>'
      + '<p style="font-size:11px;color:#666;margin:0 0 6px;">' + v.technician_name + ' · ' + v.scheduled_date + '</p>'
      + (v.tracking_count ? '<p style="font-size:10px;color:#10B981;margin:0 0 6px;">📍 ' + v.tracking_count + ' evento(s) GPS</p>' : '')
      + '<a href="/manager/visits/' + v.id + '/" style="display:block;font-size:11px;font-weight:600;color:#3B82F6;text-decoration:none;">Ver detalle →</a>'
      + '</div>';
  }

  function buildGhostPopup(site) {
    return '<div style="min-width:160px;">'
      + '<p style="font-size:13px;font-weight:700;margin:0 0 2px;">' + site.code + '</p>'
      + '<p style="font-size:11px;color:#666;margin:0 0 6px;">' + site.name + '</p>'
      + '<span style="display:inline-block;padding:1px 6px;border-radius:9px;background:#eee;font-size:10px;font-weight:600;">' + site.company.toUpperCase() + '</span>'
      + '<p style="font-size:10px;color:#aaa;margin:6px 0 0;">Sin visitas en el período</p>'
      + '</div>';
  }

  // ── Carga principal: una visita = un marcador ──

  function getFormParams() {
    var form = document.getElementById('map-filter-form');
    var data = new FormData(form);
    var params = new URLSearchParams();
    data.forEach(function (val, key) { if (val) params.append(key, val); });
    return params.toString();
  }

  // IDs de sitios con visitas en el filtro actual (para el ghost layer)
  var filteredSiteIds = new Set();

  function loadMap() {
    var loading  = document.getElementById('map-loading');
    var emptyMsg = document.getElementById('map-empty');
    var summary  = document.getElementById('map-summary');
    var summaryT = document.getElementById('map-summary-text');
    loading.classList.remove('hidden');
    emptyMsg.classList.add('hidden');
    summary.classList.add('hidden');

    fetch('/api/v1/dashboard/map-data/?' + getFormParams(), { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        clusterGroup.clearLayers();
        filteredSiteIds = new Set();

        var visits = data.visits || [];

        if (!visits.length && !showAllSites) {
          loading.classList.add('hidden');
          emptyMsg.classList.remove('hidden');
          return;
        }

        var bounds = [];
        visits.forEach(function (v) {
          if (v.lat == null || v.lng == null) return;
          filteredSiteIds.add(v.site_id);
          var marker = L.marker([v.lat, v.lng], { icon: visitIcon(v.status) });
          marker.bindPopup(buildVisitPopup(v), { maxWidth: 250 });
          clusterGroup.addLayer(marker);
          bounds.push([v.lat, v.lng]);
        });

        if (showAllSites) {
          refreshAllSitesLayer();
        }

        if (bounds.length) {
          map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
        } else if (!showAllSites) {
          emptyMsg.classList.remove('hidden');
        }

        var siteCount = (data.sites || []).length;
        summaryT.textContent = siteCount + ' sitio(s) · ' + visits.length + ' visita(s)'
          + (showAllSites ? ' (+ catálogo completo)' : '');
        summary.classList.remove('hidden');
        loading.classList.add('hidden');
      })
      .catch(function () {
        loading.classList.add('hidden');
      });
  }

  // ── Capa de todos los sitios (toggle) ──
  // Sitios con visitas muestran AMBOS iconos: el círculo de visita Y el globo del catálogo

  function refreshAllSitesLayer() {
    allSitesGroup.clearLayers();
    if (!showAllSites) return;

    fetch('/api/v1/sites/', { credentials: 'same-origin' })
      .then(function (r) { return r.json(); })
      .then(function (data) {
        var sites = Array.isArray(data) ? data : (data.results || []);
        sites.forEach(function (site) {
          var marker = L.marker([site.latitude, site.longitude], { icon: ghostSiteIcon(site.company) });
          marker.bindPopup(buildGhostPopup(site), { maxWidth: 220 });
          allSitesGroup.addLayer(marker);
        });
      })
      .catch(function () {});
  }

  // ── Toggle ──

  var toggleBtn = document.getElementById('sites-toggle-btn');
  toggleBtn.addEventListener('click', function () {
    showAllSites = !showAllSites;
    if (showAllSites) {
      toggleBtn.classList.remove('btn-ghost', 'text-base-content/50');
      toggleBtn.classList.add('btn-secondary');
      toggleBtn.style.color = '';
      refreshAllSitesLayer();
    } else {
      toggleBtn.classList.add('btn-ghost', 'text-base-content/50');
      toggleBtn.classList.remove('btn-secondary');
      allSitesGroup.clearLayers();
    }
    // Actualizar el texto del resumen
    var summaryT = document.getElementById('map-summary-text');
    if (summaryT && summaryT.textContent) {
      var base = summaryT.textContent.replace(/ \(\+ todos los sitios del catálogo\)/, '');
      summaryT.textContent = base + (showAllSites ? ' (+ todos los sitios del catálogo)' : '');
    }
  });

  // Inicializar
  loadMap();

  document.getElementById('map-filter-form').addEventListener('submit', function (e) {
    e.preventDefault();
    loadMap();
  });

  document.getElementById('map-clear-btn').addEventListener('click', function () {
    var form = document.getElementById('map-filter-form');
    form.reset();
    var dFrom = form.querySelector('[name="date_from"]');
    var dTo   = form.querySelector('[name="date_to"]');
    if (dFrom) dFrom.value = '{{ map_date_from }}';
    if (dTo)   dTo.value   = '{{ map_date_to }}';
    loadMap();
  });

  new MutationObserver(function () {
    var c = getComputedStyle(document.documentElement);
    PTI_COLOR = c.getPropertyValue('--color-info').trim() || '#3B82F6';
  }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
})();
