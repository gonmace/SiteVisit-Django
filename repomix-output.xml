<file path="templates/manager/login.html">
{% load static tailwind_tags %}
<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acceso — SiteVisit</title>
  {% tailwind_css %}
  <style>
    .field-group {
      background: #fff;
      border-radius: 12px;
      border: 1px solid rgba(0,0,0,0.09);
      overflow: hidden;
    }
    .field-row {
      display: flex;
      align-items: center;
      padding: 0 14px;
      height: 50px;
      gap: 10px;
    }
    .field-row + .field-row {
      border-top: 1px solid rgba(0,0,0,0.07);
    }
    .field-row label {
      font-size: 13.5px;
      font-weight: 500;
      color: #4a4d4e;
      min-width: 84px;
      flex-shrink: 0;
    }
    .field-row input {
      flex: 1;
      border: none;
      outline: none;
      font-size: 15px;
      color: #1c1c1e;
      background: transparent;
      font-family: inherit;
    }
    .field-row input::placeholder { color: #c7c7cc; }
  </style>
</head>
<body style="min-height:100vh; display:flex; align-items:center; justify-content:center;
             padding:24px; background:#f2f2f7; font-family:-apple-system,BlinkMacSystemFont,'SF Pro Text','Helvetica Neue',Arial,sans-serif;
             -webkit-font-smoothing:antialiased;">

  <div style="width:100%; max-width:340px; display:flex; flex-direction:column; gap:24px;">

    <!-- Icon + title -->
    <div style="text-align:center;">
      <div style="width:72px; height:72px; border-radius:18px; background:#e60000;
                  display:flex; align-items:center; justify-content:center;
                  margin:0 auto 14px; box-shadow:0 4px 16px rgba(230,0,0,0.25);">
        <span style="font-size:28px; font-weight:900; color:#fff; letter-spacing:-1px;">SV</span>
      </div>
      <p style="font-size:22px; font-weight:700; color:#1c1c1e; margin:0; letter-spacing:-0.4px;">SiteVisit</p>
      <p style="font-size:13px; color:#8e8e93; margin:5px 0 0;">Portal Manager</p>
    </div>

    <!-- Error -->
    {% if form.errors %}
      <div style="background:#fff2f2; border:1px solid rgba(220,38,38,0.2); border-radius:10px;
                  padding:10px 14px; font-size:13.5px; color:#dc2626; text-align:center;">
        Credenciales incorrectas. Verifica tu email y contraseña.
      </div>
    {% endif %}

    <!-- Form -->
    <form method="post" style="display:flex; flex-direction:column; gap:14px;">
      {% csrf_token %}
      {% if next %}<input type="hidden" name="next" value="{{ next }}">{% endif %}

      <div class="field-group">
        <div class="field-row">
          <label for="id_username">Email</label>
          <input type="email" name="username" id="id_username"
                 placeholder="tu@empresa.com" autofocus required
                 value="{{ form.username.value|default:'' }}">
        </div>
        <div class="field-row">
          <label for="id_password">Contraseña</label>
          <input type="password" name="password" id="id_password"
                 placeholder="••••••••" required>
        </div>
      </div>

      <button type="submit"
              style="display:block; width:100%; height:50px; border-radius:12px; border:none;
                     font-size:16px; font-weight:600; font-family:inherit; color:#fff;
                     background:#e60000; cursor:pointer; letter-spacing:-0.1px;
                     transition:opacity 0.15s; box-shadow:0 2px 8px rgba(230,0,0,0.2);"
              onmousedown="this.style.opacity='0.82'" onmouseup="this.style.opacity='1'"
              onmouseleave="this.style.opacity='1'">
        Entrar
      </button>
    </form>

    <p style="text-align:center; font-size:12px; color:#c7c7cc;">
      Phoenix International · SiteVisit
    </p>
  </div>

  {% if debug %}
    {% url 'django_browser_reload:reload' as reload_url %}
    <script src="{{ reload_url }}" defer></script>
  {% endif %}
</body>
</html>
</file>

<file path="templates/manager/pending_activations.html">
{% extends "manager/base.html" %}
{% load humanize user_tags %}
{% block title %}Activaciones pendientes{% endblock %}

{% block content %}

<!-- Header -->
<div class="flex items-center justify-between mb-6">
  <div>
    <h1 class="text-xl font-bold text-base-content tracking-tight">Activaciones pendientes</h1>
    <p class="text-xs text-base-content/40 mt-0.5">Dispositivos esperando aprobación</p>
  </div>
  {% if page_obj.paginator.count %}
    <span class="badge badge-warning badge-md font-semibold">
      {{ page_obj.paginator.count|intcomma }} pendiente{{ page_obj.paginator.count|pluralize }}
    </span>
  {% endif %}
</div>

{% if users %}
<!-- Table card -->
<div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs overflow-hidden">
  <div class="overflow-x-auto">
    <table class="table table-sm">
      <thead>
        <tr>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Técnico</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">RUT</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Empresa</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Dispositivo</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Registrado</th>
          <th class="text-xs font-semibold text-base-content/70 uppercase tracking-wide">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {% for tech in users %}
        <tr class="hover:bg-primary/5 transition-colors">
          <td class="py-3.5">
            <div class="flex items-center gap-2.5">
              <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center shrink-0">
                <span class="text-primary text-xs font-bold">{{ tech.get_full_name|default:tech.email|initials }}</span>
              </div>
              <div>
                <p class="text-sm font-medium text-base-content">{{ tech.get_full_name|default:tech.email }}</p>
                <p class="text-xs text-base-content/40 mt-0.5">{{ tech.email }}</p>
                {% if tech.cargo %}
                  <p class="text-xs text-base-content/30">{{ tech.cargo }}</p>
                {% endif %}
              </div>
            </div>
          </td>
          <td class="font-mono text-sm text-base-content/60 py-3.5">{{ tech.rut|default:"—" }}</td>
          <td class="py-3.5">
            <span class="badge badge-sm badge-outline">{{ tech.company|upper }}</span>
          </td>
          <td class="py-3.5">
            {% if tech.device %}
              <p class="text-sm font-medium text-base-content">{{ tech.device.manufacturer }} {{ tech.device.model }}</p>
              <p class="text-xs text-base-content/40 mt-0.5">Android {{ tech.device.os_version }}</p>
              <p class="font-mono text-xs text-base-content/30 truncate max-w-48" title="{{ tech.device.fingerprint }}">
                {{ tech.device.fingerprint|slice:":20" }}…
              </p>
            {% else %}
              <span class="text-sm text-base-content/30">Sin dispositivo</span>
            {% endif %}
          </td>
          <td class="text-sm text-base-content/50 py-3.5 whitespace-nowrap">
            {% if tech.device %}{{ tech.device.registered_at|date:"d/m/Y H:i" }}{% endif %}
          </td>
          <td class="py-3.5">
            <div class="flex items-center gap-1.5">
              <form method="post" action="{% url 'manager:approve_activation' pk=tech.pk %}">
                {% csrf_token %}
                <button type="submit"
                        class="btn btn-success btn-xs text-success-content text-xs h-7 min-h-0 px-2.5 font-medium">
                  Aprobar
                </button>
              </form>
              <button onclick="document.getElementById('reject-activation-{{ tech.pk }}').showModal()"
                      class="btn btn-ghost btn-xs text-xs h-7 min-h-0 px-2.5 text-error hover:bg-error/8">
                Rechazar
              </button>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</div>

<!-- Pagination -->
{% if page_obj.has_other_pages %}
<div class="flex justify-center items-center mt-6 gap-2">
  {% if page_obj.has_previous %}
    <a href="?page={{ page_obj.previous_page_number }}"
       class="btn btn-ghost btn-sm border border-base-300 text-secondary/60 h-9 min-h-0">‹</a>
  {% endif %}
  <span class="text-sm text-base-content/50 px-3">
    {{ page_obj.number }} / {{ page_obj.paginator.num_pages }}
  </span>
  {% if page_obj.has_next %}
    <a href="?page={{ page_obj.next_page_number }}"
       class="btn btn-ghost btn-sm border border-base-300 text-secondary/60 h-9 min-h-0">›</a>
  {% endif %}
</div>
{% endif %}

{% else %}
<!-- Empty state -->
<div class="bg-base-100 rounded-2xl border border-base-300 shadow-xs">
  <div class="flex flex-col items-center justify-center py-20 px-8 text-center">
    <div class="w-12 h-12 rounded-2xl bg-success/10 flex items-center justify-center mb-4">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-success" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
    </div>
    <p class="text-sm font-medium text-base-content/40">Sin activaciones pendientes</p>
    <p class="text-xs text-base-content/30 mt-1">Todos los dispositivos han sido procesados</p>
  </div>
</div>
{% endif %}

<!-- Reject modals -->
{% for tech in users %}
<dialog id="reject-activation-{{ tech.pk }}" class="modal modal-bottom sm:modal-middle">
  <div class="modal-box shadow-xl">
    <h3 class="font-bold text-base text-base-content">Rechazar activación</h3>
    <p class="text-sm text-base-content/50 mt-1 mb-4">
      Se eliminará el dispositivo de <strong class="text-base-content">{{ tech.get_full_name }}</strong>.
      El técnico podrá intentar activar nuevamente.
    </p>
    <form method="post" action="{% url 'manager:reject_activation' pk=tech.pk %}">
      {% csrf_token %}
      <div class="modal-action">
        <button type="button" onclick="this.closest('dialog').close()"
                class="btn btn-ghost btn-sm text-base-content/50">Cancelar</button>
        <button type="submit" class="btn btn-delete btn-sm">Rechazar dispositivo</button>
      </div>
    </form>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
{% endfor %}

{% endblock %}
</file>

